{"id":"nineveh","en":"Nineveh","ru":"Ниневия","lines":[{"l":1,"t":"Origin and antiquity of","ru":"Её происхождение и древность","r":["GEN 10:11"]},{"l":1,"t":"Situated on the river Tigris","ru":"Расположена на реке Тигр","r":["NAM 2:6","NAM 2:8"]},{"l":1,"t":"The ancient capital of Assyria","ru":"Древняя столица Ассирии","r":["2KI 19:36","ISA 37:37"]},{"l":1,"t":"Called the bloody city","ru":"Названа городом кровей","r":["NAM 3:1"]},{"l":1,"t":"Described as","ru":"Описывается как:","r":[]},{"l":2,"t":"Great","ru":"Великая","r":["JON 1:2","JON 3:2"]},{"l":2,"t":"Extensive","ru":"Обширная","r":["JON 3:3"]},{"l":2,"t":"Rich","ru":"Богатая","r":["NAM 2:9"]},{"l":2,"t":"Strong","ru":"Сильная","r":["NAM 3:12"]},{"l":2,"t":"Commercial","ru":"Торговая","r":["NAM 3:16"]},{"l":2,"t":"Populous","ru":"Многолюдная","r":["JON 4:11"]},{"l":2,"t":"Vile","ru":"Презренная","r":["NAM 1:14"]},{"l":2,"t":"Wicked","ru":"Нечестивая","r":["JON 1:2"]},{"l":2,"t":"Idolatrous","ru":"Идолопоклонническая","r":["NAM 1:14"]},{"l":2,"t":"Full of joy and carelessness","ru":"Исполненная веселья и беспечности","r":["ZEP 2:15"]},{"l":2,"t":"Full of lies and robbery","ru":"Исполненная лжи и грабежа","r":["NAM 3:1"]},{"l":2,"t":"Full of witchcraft","ru":"Исполненная чародейства","r":["NAM 3:4"]},{"l":1,"t":"Jonah sent to proclaim the destruction of","ru":"Иона послан возвестить её гибель","r":["JON 1:2","JON 3:1","JON 3:2","JON 3:4"]},{"l":1,"t":"Inhabitants of, repented at Jonah’s preaching","ru":"Жители её покаялись от проповеди Ионы","r":["JON 3:5-9","MAT 12:41","LUK 11:32"]},{"l":1,"t":"Destruction of, averted","ru":"Гибель её отвращена","r":["JHN 3:10","JHN 4:11"]},{"l":1,"t":"Predictions respecting","ru":"Предсказания о ней:","r":[]},{"l":2,"t":"Coming up of the Babylonish armies against","ru":"Нашествие вавилонских войск","r":["NAM 2:1-4","NAM 3:2"]},{"l":2,"t":"Destruction of its people","ru":"Истребление её жителей","r":["NAM 1:12","NAM 3:3"]},{"l":2,"t":"Spoiling of its treasures","ru":"Расхищение её сокровищ","r":["NAM 2:9"]},{"l":2,"t":"Destruction of its idols","ru":"Истребление её идолов","r":["NAM 1:14","NAM 2:7"]},{"l":2,"t":"Degradation and contempt put on","ru":"Позор и презрение, павшие на неё","r":["NAM 3:5-7","ZEP 2:15"]},{"l":2,"t":"Utter destruction","ru":"Полное разрушение","r":["NAM 1:8","NAM 1:9"]},{"l":2,"t":"Complete desolation","ru":"Совершенное запустение","r":["ZEP 2:13-15"]},{"l":2,"t":"Feebleness of its people","ru":"Бессилие её жителей","r":["NAM 3:13"]},{"l":2,"t":"Being taken while people were drunk","ru":"Взятие её во время опьянения жителей","r":["NAM 1:10","NAM 3:11"]},{"l":2,"t":"Captivity of its people","ru":"Плен её жителей","r":["NAM 3:10"]}]}
