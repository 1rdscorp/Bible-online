{"id":"oak-tree","en":"Oak Tree","ru":"Дуб","lines":[{"l":1,"t":"The hill of Bashan celebrated for","ru":"Гора Васанская славилась дубами","r":["ISA 2:13"]},{"l":1,"t":"Described as","ru":"Описывается как:","r":[]},{"l":2,"t":"Strong","ru":"Крепкий","r":["AMO 2:9"]},{"l":2,"t":"Thick spreading","ru":"Ветвистый","r":["2SA 18:9","EZK 6:13"]},{"l":2,"t":"Casting its leaves in winter","ru":"Сбрасывающий листья зимой","r":["ISA 6:13"]},{"l":1,"t":"The people of Tyre made oars of","ru":"Жители Тира делали из него вёсла","r":["EZK 27:6"]},{"l":1,"t":"Idolaters often made idols of","ru":"Идолопоклонники часто делали из него идолов","r":["ISA 44:14"]},{"l":1,"t":"The ancients often","ru":"Древние часто:","r":[]},{"l":2,"t":"Rested under","ru":"Отдыхали под ним","r":["JDG 6:11","JDG 6:19","1KI 13:14"]},{"l":2,"t":"Buried their dead under","ru":"Хоронили под ним умерших","r":["GEN 35:8","1CH 10:12"]},{"l":2,"t":"Erected monuments under","ru":"Ставили под ним памятники","r":["JOS 24:26"]},{"l":2,"t":"Performed idolatrous rites under","ru":"Совершали под ним идолослужение","r":["ISA 1:29","ISA 57:5","EZK 6:13","HOS 4:13"]},{"l":1,"t":"Absalom in his flight intercepted by, and suspended from","ru":"Авессалом во время бегства зацепился за дуб и повис на нём","r":["2SA 18:9","2SA 18:10","2SA 18:14"]},{"l":1,"t":"Jacob buried his family idols under","ru":"Иаков зарыл под дубом семейных идолов","r":["GEN 35:4"]},{"l":1,"t":"Illustrative","ru":"В переносном смысле:","r":[]},{"l":2,"t":"Of the church","ru":"О Церкви","r":["ISA 6:13"]},{"l":2,"t":"Of strong and powerful men","ru":"О сильных и могущественных людях","r":["AMO 2:9"]},{"l":2,"t":"Of wicked rulers","ru":"О нечестивых правителях","r":["ISA 2:13","ZEC 11:2"]},{"l":2,"t":"(Fading,) of the wicked under judgments","ru":"(Увядающий) — о нечестивых под судом","r":["ISA 1:30"]}]}
