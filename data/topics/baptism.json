{"id":"baptism","en":"Baptism","ru":"Крещение","lines":[{"l":1,"t":"As administered by John","ru":"Совершаемое Иоанном","r":["MAT 3:5-12","JHN 3:23","ACT 13:24","ACT 19:4"]},{"l":1,"t":"Sanctioned by Christ’s submission to it","ru":"Освящено тем, что Христос принял его","r":["MAT 3:13-15","LUK 3:21"]},{"l":1,"t":"Adopted by Christ","ru":"Принято Христом","r":["JHN 3:22","JHN 4:1","JHN 4:2"]},{"l":1,"t":"Appointed an ordinance of the Christian church","ru":"Установлено в христианской Церкви","r":["MAT 28:19","MAT 28:20","MRK 16:15","MRK 16:16"]},{"l":1,"t":"To be administered in the name of the Father, Son, and Holy Spirit","ru":"Совершается во имя Отца и Сына и Святого Духа","r":["MAT 28:19"]},{"l":1,"t":"Water, the outward and visible sign in","ru":"Вода — его внешний видимый знак","r":["ACT 8:36","ACT 10:47"]},{"l":1,"t":"Regeneration, the inward and spiritual grace of","ru":"Возрождение — его внутренняя духовная благодать","r":["JHN 3:3","JHN 3:5","JHN 3:6","ROM 6:3","ROM 6:4","ROM 6:11"]},{"l":1,"t":"Remission of sins, signified by","ru":"Знаменует прощение грехов","r":["ACT 2:38","ACT 22:16"]},{"l":1,"t":"Unity of the Church effected by","ru":"Созидает единство Церкви","r":["1CO 12:13","GAL 3:27","GAL 3:28"]},{"l":1,"t":"Confession of sin necessary to","ru":"Требует исповедания грехов","r":["MAT 3:6"]},{"l":1,"t":"Repentance necessary to","ru":"Требует покаяния","r":["ACT 2:38"]},{"l":1,"t":"Faith necessary to","ru":"Требует веры","r":["ACT 8:37","ACT 18:8"]},{"l":1,"t":"There is but one","ru":"Одно крещение","r":["EPH 4:5"]},{"l":1,"t":"Administered to","ru":"Совершалось над:","r":[]},{"l":2,"t":"Individuals","ru":"Отдельными людьми","r":["ACT 8:38","ACT 9:18"]},{"l":2,"t":"Households","ru":"Целыми домами","r":["ACT 16:15","1CO 1:16"]},{"l":1,"t":"Emblematic of the influences of the Holy Spirit","ru":"Образ действия Святого Духа","r":["MAT 3:11","TIT 3:5"]},{"l":1,"t":"Typified","ru":"Прообразы","r":["1CO 10:2","1PE 3:20","1PE 3:21"]}]}
