{"id":"levites","en":"Levites","ru":"Левиты","lines":[{"l":1,"t":"Descended from Jacob’s third son","r":["GEN 29:34","HEB 7:9","HEB 7:10"]},{"l":1,"t":"Prophecies respecting","r":["GEN 49:5","GEN 49:7","DEU 33:8-11"]},{"l":1,"t":"Originally consisted for three families or divisions","r":["NUM 3:17","1CH 6:16-48"]},{"l":1,"t":"Not numbered with Israel","r":["NUM 1:47-49"]},{"l":1,"t":"Numbered separately after the people from a month old","r":["NUM 3:14-16","NUM 3:39"]},{"l":1,"t":"Families, as numbered","r":[]},{"l":2,"t":"Of Gershom","r":["NUM 3:18","NUM 3:21","NUM 3:22"]},{"l":2,"t":"Of Kohath","r":["NUM 3:19","NUM 3:27","NUM 3:28"]},{"l":2,"t":"Of Merari","r":["NUM 3:20","NUM 3:33","NUM 3:34"]},{"l":1,"t":"Chosen by God for service of the sanctuary","r":["1CH 15:2","NUM 3:6"]},{"l":1,"t":"Were consecrated","r":["NUM 8:6","NUM 8:14"]},{"l":1,"t":"Taken instead of the first-born of Israel","r":["NUM 3:12","NUM 3:13","NUM 3:40-45","NUM 8:16-18"]},{"l":1,"t":"Zeal against idolatry a cause of their appointment","r":["EXO 32:26-28","DEU 33:9","DEU 33:10"]},{"l":1,"t":"Entered on their service at twenty-five years of age","r":["NUM 8:24"]},{"l":1,"t":"Numbered as ministers at thirty","r":["NUM 4:3","NUM 4:23-49"]},{"l":1,"t":"Superannuated at fifty","r":["NUM 8:25"]},{"l":1,"t":"When superannuated required to perform the less arduous duties","r":["NUM 8:26"]},{"l":1,"t":"Ceremonies at consecration of","r":[]},{"l":2,"t":"Cleansing and purifying","r":["NUM 8:7"]},{"l":2,"t":"Making a sin-offering for","r":["NUM 8:8","NUM 8:12"]},{"l":2,"t":"Elders of Israel laying their hands on them","r":["NUM 8:9","NUM 8:10"]},{"l":2,"t":"Presenting them to God as an offering for the people","r":["NUM 8:11","NUM 8:15"]},{"l":2,"t":"Setting before the priest and presenting them as their offering to God","r":["NUM 8:13"]},{"l":1,"t":"Given to Aaron and sons","r":["NUM 3:9","NUM 8:19"]},{"l":1,"t":"Encamped round the tabernacle","r":["NUM 1:50","NUM 1:52","NUM 1:53","NUM 3:23","NUM 3:29",