ицах","r":["EZK 16:24","EZK 16:31"]},{"l":2,"t":"Condemned for building","ru":"Осуждены за их устроение","r":["EZK 16:23-35"]},{"l":2,"t":"Provoked God with","ru":"Раздражали ими Бога","r":["1KI 14:22","1KI 14:23","PSA 78:58"]},{"l":2,"t":"Threatened with destruction of","ru":"Им угрожало разрушение высот","r":["LEV 26:30"]},{"l":2,"t":"Punished for","ru":"Наказаны за них","r":["2KI 17:11","2KI 17:18"]},{"l":1,"t":"Destroyed","ru":"Уничтожили их:","r":[]},{"l":2,"t":"Asa, partially","ru":"Аса, отчасти","r":["2CH 14:3","2CH 14:5","2CH 15:17"]},{"l":2,"t":"Jehoshaphat","ru":"Иосафат","r":["2CH 17:6"]},{"l":2,"t":"Hezekiah","ru":"Езекия","r":["2KI 18:4","2CH 31:1"]},{"l":2,"t":"Josiah","ru":"Иосия","r":["2KI 23:8","2CH 34:3"]},{"l":1,"t":"Not removed","ru":"Не отменили их:","r":[]},{"l":2,"t":"Jehoash","ru":"Иоас","r":["2KI 12:3"]},{"l":2,"t":"Amaziah","ru":"Амасия","r":["2KI 14:4"]},{"l":2,"t":"Azariah","ru":"Азария","r":["2KI 15:4"]},{"l":2,"t":"Jotham","ru":"Иоафам","r":["2KI 15:35"]}]}
