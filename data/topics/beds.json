{"id":"beds","en":"Beds","ru":"Постели","lines":[{"l":1,"t":"Antiquity of","ru":"Древность их","r":["GEN 47:31","EXO 8:3"]},{"l":1,"t":"Couches or divans used as","ru":"Ими служили ложа или диваны","r":["JOB 7:13","PSA 6:6"]},{"l":1,"t":"A small pallet or mattress used as","ru":"Ими служил небольшой тюфяк или подстилка","r":["1SA 19:15"]},{"l":1,"t":"Considered necessary","ru":"Считались необходимыми","r":["2KI 4:10"]},{"l":1,"t":"Made of","ru":"Делались из:","r":[]},{"l":2,"t":"Iron","ru":"Железа","r":["DEU 3:11"]},{"l":2,"t":"Ivory","ru":"Слоновой кости","r":["AMO 6:4"]},{"l":2,"t":"Gold and Silver","ru":"Золота и серебра","r":["EST 1:6"]},{"l":2,"t":"Wood","ru":"Дерева","r":["SNG 3:7-9"]},{"l":1,"t":"Supplied with pillows","ru":"Снабжались подушками","r":["1SA 19:13","1SA 26:7"]},{"l":1,"t":"Covered with tapestry and linen","ru":"Покрывались коврами и льняными тканями","r":["PRO 7:16"]},{"l":1,"t":"Often perfumed","ru":"Часто умащались благовониями","r":["PRO 7:17","EZK 23:41"]},{"l":1,"t":"Of the poor covered with upper garment","ru":"У бедных покрывались верхней одеждой","r":["EXO 22:26","EXO 22:27","DEU 24:12","DEU 24:13"]},{"l":1,"t":"Used for","ru":"Использовались:","r":[]},{"l":2,"t":"Sleeping on","ru":"Для сна","r":["JOB 33:15","LUK 11:7"]},{"l":2,"t":"Reclining on by day","ru":"Для отдыха днём","r":["2SA 4:5","2SA 11:2"]},{"l":2,"t":"Reclining on at meals","ru":"Для возлежания за трапезой","r":["1SA 28:23-25","AMO 6:4-6","LUK 7:36-38","JHN 13:23"]},{"l":1,"t":"Not used in affliction","ru":"Не употреблялись во время скорби","r":["2SA 12:16","2SA 13:31"]},{"l":1,"t":"Persons sometimes took to, in grief","ru":"Люди иногда ложились в постель от горя","r":["1KI 21:4","HOS 7:14"]},{"l":1,"t":"Saints meditate and praise God while on","ru":"Святые размышляют и славят Бога на ложе своём","r":["PSA 4:4","PSA 149:5","SNG 3:1"]},{"l":1,"t":"The wicked devise mischief while on","ru":"Нечестивые на ложах своих замышляют злодеяния","r":["PSA 36:4","MIC 2:1"]},{"l":1,"t":"The slothful too fond of","ru":"Ленивые слишком любят их","r":["PRO 26:14"]},{"l":1,"t":"Of the poor often sold for debt","ru":"Постели бедных часто отбирались за долги","r":["PRO 22:27"]},{"l":1,"t":"Subject to ceremonial defilement","ru":"Подвержены обрядовому осквернению","r":["LEV 15:4"]},{"l":1,"t":"Purification of","ru":"Очищение их","r":["MRK 7:4"]},{"l":1,"t":"Illustrative","ru":"Образ:","r":[]},{"l":2,"t":"Of the grave","ru":"Могилы","r":["ISA 57:2"]},{"l":2,"t":"(Made in darkness,) of extreme misery","ru":"(Постланные во тьме) — крайнего бедствия","r":["JOB 17:13"]},{"l":2,"t":"(Made in sickness,) of divine support and comfort","ru":"(Постланные в болезни) — Божией поддержки и утешения","r":["PSA 41:3"]},{"l":2,"t":"(Made on high,) of carnal security","ru":"(Поставленные на высоте) — плотской беспечности","r":["ISA 57:7"]},{"l":2,"t":"(Too short,) of plans which afford no rest or peace","ru":"(Слишком короткие) — замыслов, не дающих покоя и мира","r":["ISA 28:20"]}]}
