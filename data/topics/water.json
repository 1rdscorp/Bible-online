{"id":"water","en":"Water","ru":"Вода","lines":[{"l":1,"t":"One of the elements of the world","ru":"Одна из стихий мира","r":["GEN 1:2"]},{"l":1,"t":"God originally","ru":"Бог изначально:","r":[]},{"l":2,"t":"Created the firmament to divide","ru":"Сотворил твердь для разделения вод","r":["GEN 1:6","GEN 1:7"]},{"l":2,"t":"Collected into one place","ru":"Собрал воды в одно место","r":["GEN 1:9"]},{"l":2,"t":"Created fowls and fishes, &c from","ru":"Произвёл из воды птиц, рыб и т. д.","r":["GEN 1:20","GEN 1:21"]},{"l":1,"t":"Necessary to vegetation","ru":"Необходима растениям","r":["GEN 2:5","GEN 2:6","JOB 14:9","ISA 1:30"]},{"l":1,"t":"Some plants particularly require","ru":"Некоторым растениям она особенно нужна","r":["JOB 8:11"]},{"l":1,"t":"Necessary to the comfort and happiness of man","ru":"Необходима для благополучия и счастья человека","r":["ISA 41:17","ZEC 9:11"]},{"l":1,"t":"Collected in","ru":"Собирается в:","r":[]},{"l":2,"t":"Springs","ru":"Родниках","r":["JOS 15:19"]},{"l":2,"t":"Pools","ru":"Прудах","r":["1KI 22:38","NEH 2:14"]},{"l":2,"t":"Ponds","ru":"Водоёмах","r":["EXO 7:19","ISA 19:10"]},{"l":2,"t":"Fountains","ru":"Источниках","r":["1KI 18:5","2CH 32:3"]},{"l":2,"t":"Wells","ru":"Колодцах","r":["GEN 21:19"]},{"l":2,"t":"Brooks","ru":"Ручьях","r":["2SA 17:20","1KI 18:5"]},{"l":2,"t":"Streams","ru":"Потоках","r":["PSA 78:16","ISA 35:6"]},{"l":2,"t":"Rivers","ru":"Реках","r":["ISA 8:7","JER 2:18"]},{"l":2,"t":"The sea","ru":"Море","r":["GEN 1:9","GEN 1:10","ISA 11:9"]},{"l":2,"t":"The clouds","ru":"Облаках","r":["GEN 1:7","JOB 26:8","JOB 26:9"]},{"l":1,"t":"Rises in vapour to the clouds","ru":"Поднимается паром к облакам","r":["ECC 1:7","PSA 104:8"]},{"l":1,"t":"Drops from the clouds in rain","ru":"Падает из облаков дождём","r":["DEU 11:11","2SA 21:10"]},{"l":1,"t":"Described as","ru":"Описывается как:","r":[]},{"l":2,"t":"Fluid","ru":"Текучая","r":["PSA 78:16","PRO 30:4"]},{"l":2,"t":"Unstable","ru":"Неустойчивая","r":["GEN 49:4"]},{"l":2,"t":"Penetrating","ru":"Проникающая","r":["PSA 109:18"]},{"l":2,"t":"Reflecting images","ru":"Отражающая образы","r":["PRO 27:9"]},{"l":2,"t":"Wearing the hardest substances","ru":"Стирающая самые твёрдые камни","r":["JOB 14:19"]},{"l":2,"t":"Cleansing","ru":"Очищающая","r":["EZK 36:25","EPH 5:26"]},{"l":2,"t":"Refreshing","ru":"Освежающая","r":["JOB 22:7","PRO 25:25"]},{"l":1,"t":"Congealed by cold","ru":"Застывает от холода","r":["JOB 38:29","PSA 147:16","PSA 147:17"]},{"l":1,"t":"Was used by Jews","ru":"Употреблялась иудеями:","r":[]},{"l":2,"t":"As their principal beverage","ru":"Как главное питьё","r":["GEN 24:43","1KI 13:19","1KI 13:22","1KI 18:4","HOS 2:5"]},{"l":2,"t":"For culinary purposes","ru":"Для приготовления пищи","r":["EXO 12:9"]},{"l":2,"t":"For washing the person","ru":"Для омовения тела","r":["GEN 18:4","GEN 24:32"]},{"l":2,"t":"For legal purification","ru":"Для очищения по закону","r":["EXO 29:4","HEB 9:10","HEB 9:19"]},{"l":1,"t":"Kept for purification in large waterpots","ru":"Для очищения хранилась в больших водоносах","r":["JHN 2:6"]},{"l":1,"t":"Carried in vessels","ru":"Носилась в сосудах","r":["GEN 21:14","1SA 26:11","MRK 14:13"]},{"l":1,"t":"Artificial mode of conveying, into large cities","ru":"Искусственный способ подводить воду в большие города","r":["2KI 20:20"]},{"l":1,"t":"Frequently brackish and unfit for use","ru":"Часто бывала солоноватой и негодной","r":["EXO 15:23","2KI 2:19"]},{"l":1,"t":"The want of, considered a great calamity","ru":"Недостаток воды считался великим бедствием","r":["EXO 17:1-3","NUM 20:2","2KI 3:9","2KI 3:10","ISA 3:1"]},{"l":1,"t":"In times of scarcity, sold at an enormous price","ru":"Во время нужды продавалась по огромной цене","r":["LAM 5:4"]},{"l":1,"t":"Miracles connected with","ru":"Чудеса, связанные с водой:","r":[]},{"l":2,"t":"Turned into blood","ru":"Превращена в кровь","r":["EXO 7:17","EXO 7:20"]},{"l":2,"t":"Turned into wine","ru":"Превращена в вино","r":["JHN 2:7-9"]},{"l":2,"t":"Brought from the rock","ru":"Изведена из скалы","r":["EXO 17:6","NUM 20:11"]},{"l":2,"t":"Brought from the jaw-bone of an ass","ru":"Изведена из челюсти осла","r":["JDG 15:19"]},{"l":2,"t":"Consumed by fire from heaven","ru":"Поглощена огнём с неба","r":["1KI 18:38"]},{"l":2,"t":"Divided and made to stand on heap","ru":"Расступилась и стала стеной","r":["EXO 14:21","EXO 14:22","JOS 3:16"]},{"l":2,"t":"Trenches filled with","ru":"Рвы наполнились водой","r":["2KI 3:17-22"]},{"l":2,"t":"Iron made to swim in","ru":"Железо всплыло на воде","r":["2KI 6:5","2KI 6:6"]},{"l":2,"t":"Our Lord, &c walking on","ru":"Наш Господь и т. д. ходил по воде","r":["MAT 14:26-29"]},{"l":2,"t":"Healing powers communicated to","ru":"Воде сообщена целебная сила","r":["2KI 5:14","JHN 5:4","JHN 9:7"]},{"l":1,"t":"The world and its inhabitants once destroyed by","ru":"Мир и его обитатели однажды истреблены водой","r":["GEN 7:20-23","2PE 3:6"]},{"l":1,"t":"The world not to be again destroyed by","ru":"Мир не будет больше истреблён водой","r":["GEN 9:8-15","2PE 3:7"]},{"l":1,"t":"Illustrative","ru":"В переносном смысле:","r":[]},{"l":2,"t":"Of the support of God","ru":"Образ поддержки Божией","r":["ISA 8:6"]},{"l":2,"t":"Of the gifts and graces of the Holy Spirit","ru":"Образ даров и благодати Святого Духа","r":["ISA 41:17","ISA 41:18","ISA 44:3","EZK 36:25","JHN 7:38","JHN 7:39"]},{"l":2,"t":"Of persecutors","ru":"Образ гонителей","r":["PSA 124:4","PSA 124:5"]},{"l":2,"t":"Of persecutions","ru":"Образ гонений","r":["PSA 88:17"]},{"l":2,"t":"Of hostile armies","ru":"Образ вражеских войск","r":["ISA 8:7","ISA 17:13"]},{"l":2,"t":"(Still,) of the ordinances of the gospel","ru":"(Тихие воды) образ установлений Евангелия","r":["PSA 23:2"]},{"l":2,"t":"(Deep,) of severe affliction","ru":"(Глубокие воды) образ тяжкой скорби","r":["PSA 66:12","PSA 69:1","ISA 30:20","ISA 43:2"]},{"l":2,"t":"(Deep,) of counsel in the heart","ru":"(Глубокие воды) образ помыслов в сердце","r":["PRO 20:5"]},{"l":2,"t":"(Deep,) of the words of the wise of the wise","ru":"(Глубокие воды) образ слов мудрого","r":["PRO 18:4"]},{"l":2,"t":"(Poured out,) of the wrath of God","ru":"(Изливаемая вода) образ гнева Божия","r":["HOS 5:10"]},{"l":2,"t":"(Poured out,) of faintness by terror","ru":"(Пролитая вода) образ изнеможения от ужаса","r":["PSA 22:14"]},{"l":2,"t":"(Pouring, out of buckets,) of a numerous progeny","ru":"(Вода, льющаяся из вёдер) образ многочисленного потомства","r":["NUM 24:7"]},{"l":2,"t":"(Spilled on the ground,) of death","ru":"(Пролитая на землю вода) образ смерти","r":["2SA 14:14"]},{"l":2,"t":"(Its instability,) of a wavering disposition","ru":"(Неустойчивость воды) образ непостоянного нрава","r":["GEN 49:4"]},{"l":2,"t":"(Its weakness,) of faintness and cowardice","ru":"(Слабость воды) образ изнеможения и малодушия","r":["JOS 7:5","EZK 7:17"]},{"l":2,"t":"(Difficulty of stopping,) of strife and contention","ru":"(Трудность остановить воду) образ ссор и раздоров","r":["PRO 17:14"]},{"l":2,"t":"(Rapidly flowing away,) of the career of the wicked","ru":"(Быстро утекающая вода) образ жизненного пути нечестивых","r":["JOB 24:18","PSA 58:7"]},{"l":2,"t":"(Many,) of different nations and people","ru":"(Многие воды) образ различных народов и племён","r":["REV 17:1","REV 17:15","JER 51:13"]},{"l":2,"t":"(Many,) of a variety of afflictions","ru":"(Многие воды) образ многих скорбей","r":["2SA 22:17"]},{"l":2,"t":"(Noise of many,) of the word of Christ","ru":"(Шум многих вод) образ голоса Христа","r":["REV 1:15"]},{"l":2,"t":"(Covering the sea,) of the general diffusion of the knowledge of God","ru":"(Воды, покрывающие море) образ всеобщего распространения познания Бога","r":["ISA 11:9","HAB 2:14"]}]}
