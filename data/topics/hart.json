{"id":"hart","en":"Hart","ru":"Олень","lines":[{"l":1,"t":"Clean and used as food","ru":"Чистое животное, употреблялся в пищу","r":["DEU 12:15","DEU 14:5"]},{"l":1,"t":"Often hunted","ru":"На него часто охотились","r":["LAM 1:6"]},{"l":1,"t":"Female of","ru":"Самка:","r":[]},{"l":2,"t":"Called the hind","ru":"Называется ланью","r":["SNG 2:7"]},{"l":2,"t":"Delights in freedom","ru":"Любит свободу","r":["GEN 49:21"]},{"l":2,"t":"Kind and affectionate","ru":"Ласкова и любезна","r":["PRO 5:19"]},{"l":2,"t":"Brings forth at appointed time","ru":"Рождает в назначенное время","r":["JOB 39:1","JOB 39:2"]},{"l":2,"t":"Brings forth with difficulty","ru":"Рождает с трудом","r":["JOB 39:3"]},{"l":2,"t":"Brings forth at the voice of God","ru":"Разрешается от бремени гласом Господа","r":["PSA 29:9"]},{"l":2,"t":"Forsakes her young in famine","ru":"Оставляет детёныша во время голода","r":["JER 14:5"]},{"l":1,"t":"Young of, abundantly provided for","ru":"Детёныши его обильно обеспечены","r":["JOB 39:4"]},{"l":1,"t":"Illustrative","ru":"В переносном смысле:","r":[]},{"l":2,"t":"Of Christ","ru":"Христос","r":["SNG 2:9","SNG 2:17","SNG 8:14"]},{"l":2,"t":"Of converted sinners","ru":"Обращённые грешники","r":["ISA 35:6"]},{"l":2,"t":"(Sure-footedness of,) of experienced saints","ru":"(Твёрдость его поступи) — опытные святые","r":["PSA 18:33","HAB 3:19"]},{"l":2,"t":"(Panting for water,) of afflicted saints longing for God","ru":"(Желающий к потокам вод) — скорбящие святые, жаждущие Бога","r":["PSA 42:1","PSA 42:2"]},{"l":2,"t":"(Without pasture,) of the persecuted","ru":"(Не находящий пажити) — гонимые","r":["LAM 1:6"]}]}
