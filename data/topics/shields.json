{"id":"shields","en":"Shields","ru":"Щиты","lines":[{"l":1,"t":"A part of defensive armour","r":["PSA 115:9","PSA 140:7"]},{"l":1,"t":"Frequently made of, or covered with","r":[]},{"l":2,"t":"Gold","r":["2SA 8:7","1KI 10:17"]},{"l":2,"t":"Brass","r":["1KI 14:27"]},{"l":1,"t":"Said to belong to God","r":["PSA 47:9"]},{"l":1,"t":"Kinds of","r":[]},{"l":2,"t":"The buckler or target","r":["2CH 9:15","1CH 5:18","EZK 26:8"]},{"l":2,"t":"The small shield","r":["2CH 9:16"]},{"l":2,"t":"Often borne by an armour bearer","r":["1SA 17:7"]},{"l":1,"t":"Before war","r":[]},{"l":2,"t":"Gathered together","r":["JER 51:11"]},{"l":2,"t":"Uncovered","r":["ISA 22:6"]},{"l":2,"t":"Repaired","r":["JER 46:3"]},{"l":2,"t":"Anointed","r":["2SA 1:21","ISA 21:5"]},{"l":2,"t":"Often made red","r":["NAM 2:3"]},{"l":1,"t":"Provided by the kings of Israel in great abundance","r":["2CH 11:12","2CH 26:14","2CH 32:5"]},{"l":1,"t":"A disgrace to lose, or throw away","r":["2SA 1:21"]},{"l":1,"t":"Of the vanquished, often burned","r":["EZK 39:9"]},{"l":1,"t":"In times of peace were hung up in towers or armouries","r":["EZK 27:10","SNG 4:4"]},{"l":1,"t":"Were scarce in Israel in the days of Deborah and Barak","r":["JDG 5:8"]},{"l":1,"t":"Many of the Israelites used, with expertness","r":["1CH 12:8","1CH 12:24","1CH 12:34","2CH 14:8","2CH 25:5"]},{"l":1,"t":"Illustrative of","r":[]},{"l":2,"t":"Protection of God","r":["GEN 15:1","PSA 33:20"]},{"l":2,"t":"Favour of God","r":["PSA 5:12"]},{"l":2,"t":"Truth of God","r":["PSA 91:4"]},{"l":2,"t":"Salvation of God","r":["2SA 22:36","PSA 18:35"]},{"l":2,"t":"Faith","r":["EPH 6:16"]}]}
