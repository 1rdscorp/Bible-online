{"id":"shields","en":"Shields","ru":"Щиты","lines":[{"l":1,"t":"A part of defensive armour","ru":"Часть оборонительного вооружения","r":["PSA 115:9","PSA 140:7"]},{"l":1,"t":"Frequently made of, or covered with","ru":"Часто делались из следующих металлов или обкладывались ими:","r":[]},{"l":2,"t":"Gold","ru":"Золото","r":["2SA 8:7","1KI 10:17"]},{"l":2,"t":"Brass","ru":"Медь","r":["1KI 14:27"]},{"l":1,"t":"Said to belong to God","ru":"Принадлежат Богу","r":["PSA 47:9"]},{"l":1,"t":"Kinds of","ru":"Виды их:","r":[]},{"l":2,"t":"The buckler or target","ru":"Большой щит","r":["2CH 9:15","1CH 5:18","EZK 26:8"]},{"l":2,"t":"The small shield","ru":"Малый щит","r":["2CH 9:16"]},{"l":2,"t":"Often borne by an armour bearer","ru":"Часто носились оруженосцем","r":["1SA 17:7"]},{"l":1,"t":"Before war","ru":"Перед войной:","r":[]},{"l":2,"t":"Gathered together","ru":"Собирались","r":["JER 51:11"]},{"l":2,"t":"Uncovered","ru":"Обнажались","r":["ISA 22:6"]},{"l":2,"t":"Repaired","ru":"Исправлялись","r":["JER 46:3"]},{"l":2,"t":"Anointed","ru":"Помазывались","r":["2SA 1:21","ISA 21:5"]},{"l":2,"t":"Often made red","ru":"Часто окрашивались в красный цвет","r":["NAM 2:3"]},{"l":1,"t":"Provided by the kings of Israel in great abundance","ru":"Цари израильские заготовляли их в большом количестве","r":["2CH 11:12","2CH 26:14","2CH 32:5"]},{"l":1,"t":"A disgrace to lose, or throw away","ru":"Потерять или бросить щит — позор","r":["2SA 1:21"]},{"l":1,"t":"Of the vanquished, often burned","ru":"Щиты побеждённых часто сжигались","r":["EZK 39:9"]},{"l":1,"t":"In times of peace were hung up in towers or armouries","ru":"В мирное время вешались на башнях или в оружейных","r":["EZK 27:10","SNG 4:4"]},{"l":1,"t":"Were scarce in Israel in the days of Deborah and Barak","ru":"Были редки в Израиле во дни Деворы и Варака","r":["JDG 5:8"]},{"l":1,"t":"Many of the Israelites used, with expertness","ru":"Многие израильтяне искусно владели ими","r":["1CH 12:8","1CH 12:24","1CH 12:34","2CH 14:8","2CH 25:5"]},{"l":1,"t":"Illustrative of","ru":"Образ:","r":[]},{"l":2,"t":"Protection of God","ru":"Защиты Божией","r":["GEN 15:1","PSA 33:20"]},{"l":2,"t":"Favour of God","ru":"Благоволения Божия","r":["PSA 5:12"]},{"l":2,"t":"Truth of God","ru":"Истины Божией","r":["PSA 91:4"]},{"l":2,"t":"Salvation of God","ru":"Спасения Божия","r":["2SA 22:36","PSA 18:35"]},{"l":2,"t":"Faith","ru":"Веры","r":["EPH 6:16"]}]}
