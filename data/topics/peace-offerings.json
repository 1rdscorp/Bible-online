{"id":"peace-offerings","en":"Peace Offerings","ru":"Мирные жертвы","lines":[{"l":1,"t":"A male or female of herd or flock","ru":"Самец или самка из крупного или мелкого скота","r":["LEV 3:1","LEV 3:6","LEV 3:12"]},{"l":1,"t":"The offerer required","ru":"Приносящий должен был:","r":[]},{"l":2,"t":"To give it freely","ru":"Отдать её добровольно","r":["LEV 19:5"]},{"l":2,"t":"To bring it himself","ru":"Привести её сам","r":["LEV 7:29","LEV 7:30"]},{"l":2,"t":"To lay his hand upon its head","ru":"Возложить руку на её голову","r":["LEV 3:2","LEV 3:8","LEV 3:13"]},{"l":2,"t":"To kill it at tabernacle door","ru":"Заколоть её у входа скинии","r":["LEV 3:2","LEV 8:13"]},{"l":1,"t":"Required to be perfect and free from blemish","ru":"Должна быть совершенной, без порока","r":["LEV 3:1","LEV 3:6","LEV 22:21"]},{"l":1,"t":"The priest","ru":"Священник:","r":[]},{"l":2,"t":"Prepared","ru":"Приготовлял её","r":["EZK 46:2"]},{"l":2,"t":"Sprinkled the blood on the altar","ru":"Кропил кровью на жертвенник","r":["LEV 3:2","LEV 3:8","LEV 3:13"]},{"l":2,"t":"Offered the inside fat, &c by fire","ru":"Сжигал внутренний тук и т. д.","r":["LEV 3:3","LEV 3:4","LEV 3:9","LEV 3:10"]},{"l":2,"t":"Laid it upon the daily burnt offering to be consumed with it","ru":"Полагал её на ежедневное всесожжение, чтобы сжечь вместе с ним","r":["LEV 3:5","LEV 6:12","LEV 6:13"]},{"l":2,"t":"Waved the breast as a wave-offering","ru":"Потрясал грудь как приношение потрясания","r":["EXO 29:26","EXO 29:28","LEV 7:29","LEV 7:30"]},{"l":2,"t":"Heaved the right shoulder as an heave-offering","ru":"Возносил правое плечо как возношение","r":["EXO 29:22-27"]},{"l":2,"t":"Had the shoulder and breast as his portion","ru":"Получал плечо и грудь в свою долю","r":["EXO 29:28","LEV 7:31-34"]},{"l":2,"t":"An offering most acceptable","ru":"Весьма угодное приношение","r":["LEV 3:5","LEV 3:16"]},{"l":2,"t":"Generally accompanied by a burnt-offering","ru":"Обычно сопровождалась всесожжением","r":["JDG 21:4","1SA 10:8","1KI 3:15"]},{"l":2,"t":"Often accompanied by a sin-offering","ru":"Часто сопровождалась жертвой за грех","r":["LEV 23:19"]},{"l":1,"t":"Was offered","ru":"Приносилась:","r":[]},{"l":2,"t":"As a thanksgiving-offering","ru":"В благодарность","r":["LEV 7:12","LEV 7:13"]},{"l":2,"t":"As a votive offering","ru":"По обету","r":["LEV 7:16"]},{"l":2,"t":"For reconciliation","ru":"Для примирения","r":["EZK 45:15","EPH 2:13","EPH 2:14"]},{"l":2,"t":"For confirming the legal covenant","ru":"Для утверждения завета закона","r":["EXO 24:5"]},{"l":2,"t":"At consecration of priests","ru":"При посвящении священников","r":["EXO 29:22","EXO 29:29"]},{"l":2,"t":"For the people at large","ru":"За весь народ","r":["LEV 9:4"]},{"l":2,"t":"At expiration of Nazarite’s vow","ru":"По окончании обета назорейства","r":["NUM 6:14"]},{"l":2,"t":"At all the festivals","ru":"На всех праздниках","r":["NUM 10:10"]},{"l":2,"t":"At dedication of tabernacle","ru":"При освящении скинии","r":["NUM 7:17","NUM 7:23"]},{"l":2,"t":"At dedication of temple","ru":"При освящении храма","r":["1KI 8:62-64"]},{"l":2,"t":"At coronation of kings","ru":"При воцарении царей","r":["1SA 11:15"]},{"l":2,"t":"By Joshua after his victories","ru":"Иисусом Навином после побед","r":["JOS 8:31"]},{"l":2,"t":"By Israel after their defeat","ru":"Израилем после поражения","r":["JDG 20:26"]},{"l":2,"t":"By David on bringing up the ark","ru":"Давидом при перенесении ковчега","r":["2SA 6:17"]},{"l":2,"t":"By David after the plague","ru":"Давидом после язвы","r":["2SA 24:25"]},{"l":2,"t":"By Solomon three times a year","ru":"Соломоном три раза в год","r":["1KI 9:25"]},{"l":2,"t":"By Manasseh on repairing and restoring the altar","ru":"Манассией при восстановлении жертвенника","r":["2CH 33:15","2CH 33:16"]},{"l":1,"t":"If a thanksgiving offering to be eaten the day offered","ru":"Благодарственную съедали в день принесения","r":["LEV 7:15"]},{"l":1,"t":"If a votive offering to be eaten the same day or the next","ru":"Обетную съедали в тот же или на следующий день","r":["LEV 7:16","LEV 7:17","LEV 19:6-8"]},{"l":1,"t":"To be eaten before the Lord","ru":"Съедалась пред Господом","r":["DEU 12:17","DEU 12:18"]},{"l":1,"t":"No unclean person to eat of","ru":"Нечистый не мог есть от неё","r":["LEV 7:20","LEV 7:21"]}]}
