{"id":"peace-offerings","en":"Peace Offerings","ru":"Мирные жертвы","lines":[{"l":1,"t":"A male or female of herd or flock","r":["LEV 3:1","LEV 3:6","LEV 3:12"]},{"l":1,"t":"The offerer required","r":[]},{"l":2,"t":"To give it freely","r":["LEV 19:5"]},{"l":2,"t":"To bring it himself","r":["LEV 7:29","LEV 7:30"]},{"l":2,"t":"To lay his hand upon its head","r":["LEV 3:2","LEV 3:8","LEV 3:13"]},{"l":2,"t":"To kill it at tabernacle door","r":["LEV 3:2","LEV 8:13"]},{"l":1,"t":"Required to be perfect and free from blemish","r":["LEV 3:1","LEV 3:6","LEV 22:21"]},{"l":1,"t":"The priest","r":[]},{"l":2,"t":"Prepared","r":["EZK 46:2"]},{"l":2,"t":"Sprinkled the blood on the altar","r":["LEV 3:2","LEV 3:8","LEV 3:13"]},{"l":2,"t":"Offered the inside fat, &c by fire","r":["LEV 3:3","LEV 3:4","LEV 3:9","LEV 3:10"]},{"l":2,"t":"Laid it upon the daily burnt offering to be consumed with it","r":["LEV 3:5","LEV 6:12","LEV 6:13"]},{"l":2,"t":"Waved the breast as a wave-offering","r":["EXO 29:26","EXO 29:28","LEV 7:29","LEV 7:30"]},{"l":2,"t":"Heaved the right shoulder as an heave-offering","r":["EXO 29:22-27"]},{"l":2,"t":"Had the shoulder and breast as his portion","r":["EXO 29:28","LEV 7:31-34"]},{"l":2,"t":"An offering most acceptable","r":["LEV 3:5","LEV 3:16"]},{"l":2,"t":"Generally accompanied by a burnt-offering","r":["JDG 21:4","1SA 10:8","1KI 3:15"]},{"l":2,"t":"Often accompanied by a sin-offering","r":["LEV 23:19"]},{"l":1,"t":"Was offered","r":[]},{"l":2,"t":"As a thanksgiving-offering","r":["LEV 7:12","LEV 7:13"]},{"l":2,"t":"As a votive offering","r":["LEV 7:16"]},{"l":2,"t":"For reconciliation","r":["EZK 45:15","EPH 2:13","EPH 2:14"]},{"l":2,"t":"For confirming the legal covenant","r":["EXO 24:5"]},{"l":2,"t":"At consecration of priests","r":["EXO 29:22","EXO 29:29"]},{"l":2,"t":"For the people at large","r":["LEV 9:4"]},{"l":2,"t":"At expiration of Nazarite’s vow","r":["NUM 6:14"]},{"l":2,"t":"At all the festivals","r":["NUM 10:10"]},{"l":2,"t":"At dedication of tabe