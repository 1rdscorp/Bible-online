{"id":"ascension-of-christ","en":"Ascension of Christ","ru":"Вознесение Христа","lines":[{"l":1,"t":"Prophecies respecting","ru":"Пророчества о нём","r":["PSA 24:7","PSA 68:18","EPH 4:7","EPH 4:8"]},{"l":1,"t":"Foretold by himself","ru":"Предсказано Им Самим","r":["JHN 6:62","JHN 7:33","JHN 14:28","JHN 16:5","JHN 20:17"]},{"l":1,"t":"Forty days after his resurrection","ru":"Через сорок дней после Его воскресения","r":["ACT 1:3"]},{"l":1,"t":"Described","ru":"Описание","r":["ACT 1:9"]},{"l":1,"t":"From Mount Olivet","ru":"С горы Елеонской","r":["LUK 24:50","MRK 11:1","ACT 1:12"]},{"l":1,"t":"While blessing his disciples","ru":"Когда Он благословлял Своих учеников","r":["LUK 24:50"]},{"l":1,"t":"When he had atoned for sin","ru":"Когда Он совершил очищение грехов","r":["HEB 9:12","HEB 10:12"]},{"l":1,"t":"Was triumphant","ru":"Торжественно","r":["PSA 68:18"]},{"l":1,"t":"Was to supreme power and dignity","ru":"К высшей власти и славе","r":["LUK 24:26","EPH 1:20","EPH 1:21","1PE 3:22"]},{"l":1,"t":"As the forerunner of his people","ru":"Как Предтеча Своего народа","r":["HEB 6:20"]},{"l":1,"t":"To intercede","ru":"Чтобы ходатайствовать","r":["ROM 8:34","HEB 9:24"]},{"l":1,"t":"To send the Holy Spirit","ru":"Чтобы послать Святого Духа","r":["JHN 16:7","ACT 2:33"]},{"l":1,"t":"To receive gifts for men","ru":"Чтобы принять дары для человеков","r":["PSA 68:18","EPH 4:8","EPH 4:11"]},{"l":1,"t":"To prepare a place for his people","ru":"Чтобы приготовить место Своему народу","r":["JHN 14:2"]},{"l":1,"t":"His second coming shall be in like manner as","ru":"Второе пришествие Его будет таким же образом","r":["ACT 1:10","ACT 1:11"]},{"l":1,"t":"Typified","ru":"Прообразы","r":["LEV 16:15","HEB 6:20","HEB 9:7","HEB 9:9","HEB 9:12"]}]}
