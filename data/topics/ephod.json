{"id":"ephod","en":"Ephod","ru":"Ефод","lines":[{"l":1,"t":"The emblem of the priestly office","r":["HOS 3:4"]},{"l":1,"t":"Worn by","r":[]},{"l":2,"t":"The high priest","r":["1SA 2:28","1SA 14:3"]},{"l":2,"t":"Ordinary priests","r":["1SA 22:18"]},{"l":2,"t":"Persons engaged in the service of God","r":["1SA 2:18","2SA 6:14"]},{"l":2,"t":"Generally of linen","r":["1SA 2:18","2SA 6:14"]},{"l":1,"t":"For the high priest","r":[]},{"l":2,"t":"Commanded to be made","r":["EXO 28:4"]},{"l":2,"t":"Made of offerings of the people","r":["EXO 25:4","EXO 25:7"]},{"l":2,"t":"Made of gold, blue, purple, scarlet, &c","r":["EXO 28:6","EXO 29:2","EXO 29:3"]},{"l":2,"t":"Shoulders of, joined by onyx stones engraved with names of the twelve tribes of Israel","r":["EXO 28:7","EXO 28:9-12","EXO 39:4","EXO 39:6","EXO 39:7"]},{"l":2,"t":"Had a girdle of curious work","r":["EXO 28:8"]},{"l":2,"t":"Breastplate of judgment inseparably united to","r":["EXO 28:25-28","EXO 39:20","EXO 39:21"]},{"l":2,"t":"Worn over the robe","r":["EXO 28:31","LEV 8:7"]},{"l":2,"t":"Fastened on with its own girdle","r":["LEV 8:7"]},{"l":2,"t":"Worn or held by him when consulted","r":["1SA 23:6","1SA 23:9-12","1SA 30:7","1SA 30:8"]},{"l":2,"t":"Used by idolatrous priests","r":["JDG 8:27","JDG 17:5","JDG 18:14"]},{"l":2,"t":"Israel deprived of, for sin","r":["HOS 3:4"]}]}
