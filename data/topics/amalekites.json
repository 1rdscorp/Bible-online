{"id":"amalekites","en":"Amalekites","ru":"Амаликитяне","lines":[{"l":1,"t":"Descent of","ru":"Происхождение","r":["GEN 36:12","GEN 36:16"]},{"l":1,"t":"Character of","ru":"Характер:","r":[]},{"l":2,"t":"Wicked","ru":"Нечестивы","r":["1SA 15:18"]},{"l":2,"t":"Oppressive","ru":"Притеснители","r":["JDG 10:12"]},{"l":2,"t":"Warlike and Cruel","ru":"Воинственны и жестоки","r":["1SA 15:33"]},{"l":1,"t":"Governed by Kings","ru":"Управлялись царями","r":["1SA 15:20","1SA 15:32"]},{"l":1,"t":"A powerful and influential nation","ru":"Сильный и влиятельный народ","r":["NUM 24:7"]},{"l":1,"t":"Possessed cities","ru":"Имели города","r":["1SA 15:5"]},{"l":1,"t":"COUNTRY of","ru":"Страна их:","r":[]},{"l":2,"t":"In the south of Canaan","ru":"На юге Ханаана","r":["NUM 13:29","1SA 27:8"]},{"l":2,"t":"Extended from Havilah to Shur","ru":"Простиралась от Хавилы до Сура","r":["1SA 15:7"]},{"l":2,"t":"Was the scene of ancient warfare","ru":"Место древних войн","r":["GEN 14:7"]},{"l":1,"t":"Part of the Kenites dwelt amongst","ru":"Часть кенеев жила среди них","r":["1SA 15:6"]},{"l":1,"t":"Were the first to oppose Israel","ru":"Первыми выступили против Израиля","r":["EXO 17:8"]},{"l":1,"t":"Discomfited at Rephidim through the intercession of Moses","ru":"Поражены при Рефидиме по ходатайству Моисея","r":["EXO 17:9-13"]},{"l":1,"t":"Doomed to utter destruction for opposing Israel","ru":"Обречены на полное истребление за противление Израилю","r":["EXO 17:14","EXO 17:16","DEU 25:19"]},{"l":1,"t":"Their utter destruction foretold","ru":"Предсказано их полное истребление","r":["NUM 24:20"]},{"l":1,"t":"Presumption of Israel punished by","ru":"Израиль наказан ими за дерзость","r":["NUM 14:45"]},{"l":1,"t":"United with Eglon against Israel","ru":"Объединились с Еглоном против Израиля","r":["JDG 3:13"]},{"l":1,"t":"Part of their possessions taken by Ephraim","ru":"Часть их владений захвачена Ефремом","r":["JDG 5:14","JDG 12:15"]},{"l":1,"t":"With Midian, oppressed Israel","ru":"Вместе с мадианитянами угнетали Израиль","r":["JDG 6:3-5"]},{"l":1,"t":"Overcome by Gideon","ru":"Побеждены Гедеоном","r":["JDG 6:33","JDG 6:34","JDG 7:21","JDG 7:22"]},{"l":1,"t":"Saul","ru":"Саул:","r":[]},{"l":2,"t":"Overcame, and delivered Israel","ru":"Победил их и избавил Израиль","r":["1SA 14:48"]},{"l":2,"t":"Commissioned to destroy","ru":"Получил повеление истребить их","r":["1SA 15:1-3"]},{"l":2,"t":"Massacred","ru":"Избивал их","r":["1SA 15:4-8"]},{"l":2,"t":"Condemned for not utterly destroying","ru":"Осуждён за то, что не истребил их до конца","r":["1SA 15:9-26","1SA 28:18"]},{"l":1,"t":"Agag, king of, slain by Samuel","ru":"Агаг, царь их, убит Самуилом","r":["1SA 15:32","1SA 15:33"]},{"l":1,"t":"Invaded by David","ru":"Давид совершал набеги на них","r":["1SA 27:8","1SA 27:9"]},{"l":1,"t":"Pillaged and burned Ziklag","ru":"Разграбили и сожгли Секелаг","r":["1SA 30:1","1SA 30:2"]},{"l":1,"t":"Pursued and slain by David","ru":"Давид преследовал и поразил их","r":["1SA 30:10-20"]},{"l":1,"t":"Spoil taken from, consecrated","ru":"Добыча, взятая у них, посвящена Богу","r":["2SA 8:11","2SA 8:12"]},{"l":1,"t":"Confederated against Israel","ru":"Вступили в союз против Израиля","r":["PSA 83:7"]},{"l":1,"t":"Remnant of, completely destroyed during the reign of Hezekiah","ru":"Остаток их полностью истреблён в царствование Езекии","r":["1CH 4:41-43"]}]}
