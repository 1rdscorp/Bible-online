{"id":"affliction-prayer-under","en":"Affliction, Prayer Under","ru":"Молитва в скорби","lines":[{"l":1,"t":"Exhortation to","r":["JAS 5:13"]},{"l":1,"t":"That God would consider our trouble","r":["2KI 19:16","NEH 9:32","PSA 9:13","LAM 5:1"]},{"l":1,"t":"For the presence and support of God","r":["PSA 10:1","PSA 102:2"]},{"l":1,"t":"That the Holy Spirit may not be withdrawn","r":["PSA 51:11"]},{"l":1,"t":"For divine comfort","r":["PSA 4:6","PSA 119:76"]},{"l":1,"t":"For mitigation of troubles","r":["PSA 39:12","PSA 39:13"]},{"l":1,"t":"For deliverance","r":["PSA 25:17","PSA 25:22","PSA 39:10","ISA 64:9-12","JER 17:14"]},{"l":1,"t":"For pardon and deliverance from sin","r":["PSA 39:8","PSA 51:1","PSA 79:8"]},{"l":1,"t":"That we may be turned to God","r":["PSA 80:7","PSA 85:4-6","JER 31:18"]},{"l":1,"t":"For divine teaching and direction","r":["JOB 34:32","PSA 27:11","PSA 143:10"]},{"l":1,"t":"For increase of faith","r":["MRK 9:24"]},{"l":1,"t":"For mercy","r":["PSA 6:2","HAB 3:2"]},{"l":1,"t":"For restoration to joy","r":["PSA 51:8","PSA 51:12","PSA 69:29","PSA 90:14","PSA 90:15"]},{"l":1,"t":"For protection and preservation from enemies","r":["2KI 19:19","2CH 20:12","PSA 17:8","PSA 17:9"]},{"l":1,"t":"That we may know the causes of our trouble","r":["JOB 6:24","JOB 10:2","JOB 13:23","JOB 13:24"]},{"l":1,"t":"That we may be taught the uncertainty of life","r":["PSA 39:4"]},{"l":1,"t":"That we may be quickened","r":["PSA 143:11"]}]}
