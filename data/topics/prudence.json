{"id":"prudence","en":"Prudence","ru":"Благоразумие","lines":[{"l":1,"t":"Exhibited in the manifestation of God’s grace","ru":"Проявилось в явлении благодати Божией","r":["EPH 1:8"]},{"l":1,"t":"Exemplified by Christ","ru":"Пример Христа","r":["ISA 52:13","MAT 21:24-27","MAT 22:15-21"]},{"l":1,"t":"Intimately connected with wisdom","ru":"Тесно связано с мудростью","r":["PRO 8:12"]},{"l":1,"t":"The wise celebrated for","ru":"Мудрые славятся им","r":["PRO 16:21"]},{"l":1,"t":"They who have","ru":"Обладающие им:","r":[]},{"l":2,"t":"Get knowledge","ru":"Приобретают знание","r":["PRO 18:15"]},{"l":2,"t":"Deal with knowledge","ru":"Действуют со знанием","r":["PRO 13:16"]},{"l":2,"t":"Look well to their goings","ru":"Внимательны к путям своим","r":["PRO 14:15"]},{"l":2,"t":"Understand the ways of God","ru":"Разумеют пути Божии","r":["HOS 14:9"]},{"l":2,"t":"Understand their own ways","ru":"Разумеют свой путь","r":["PRO 14:8"]},{"l":2,"t":"Crowned with knowledge","ru":"Увенчиваются знанием","r":["PRO 14:18"]},{"l":2,"t":"Not ostentatious of knowledge","ru":"Скрывают знание","r":["PRO 12:23"]},{"l":2,"t":"Foresee and avoid evil","ru":"Предвидят беду и укрываются","r":["PRO 22:3"]},{"l":2,"t":"Are preserved by it","ru":"Сохраняются им","r":["PRO 2:11"]},{"l":2,"t":"Suppress angry feelings","ru":"Сдерживают гнев","r":["PRO 12:16","PRO 19:11"]},{"l":2,"t":"Regard reproof","ru":"Внимают обличениям","r":["PRO 15:5"]},{"l":2,"t":"Keep silence in the evil time","ru":"Безмолвствуют в злое время","r":["AMO 5:13"]},{"l":1,"t":"Saints act with","ru":"Святые поступают благоразумно","r":["PSA 112:5"]},{"l":1,"t":"Saints should especially exercise, in their intercourse with unbelievers","ru":"Святые должны быть особенно благоразумны в общении с неверующими","r":["MAT 10:16","EPH 5:15","COL 4:5"]},{"l":1,"t":"Virtuous wives act with","ru":"Добродетельные жёны поступают благоразумно","r":["PRO 31:16","PRO 31:26"]},{"l":1,"t":"The young should cultivate","ru":"Юным следует развивать его","r":["PRO 3:21"]},{"l":1,"t":"Of the wicked","ru":"Благоразумие нечестивых:","r":[]},{"l":2,"t":"Fails in times of perplexity","ru":"Изменяет им в затруднениях","r":["JER 49:7"]},{"l":2,"t":"Keeps them from the knowledge of the gospel","ru":"Мешает им познать Евангелие","r":["MAT 11:25"]},{"l":2,"t":"Denounced by God","ru":"Осуждено Богом","r":["ISA 5:21","ISA 29:15"]},{"l":2,"t":"Defeated by God","ru":"Посрамлено Богом","r":["ISA 29:14","1CO 1:19"]},{"l":2,"t":"Necessity for","ru":"Необходимость благоразумия","r":["MAT 25:3","MAT 25:9","LUK 14:28-32"]},{"l":1,"t":"Exemplified","ru":"Примеры:","r":[]},{"l":2,"t":"Jacob","ru":"Иаков","r":["GEN 32:3-23"]},{"l":2,"t":"Joseph","ru":"Иосиф","r":["GEN 41:39"]},{"l":2,"t":"Jethro","ru":"Иофор","r":["EXO 18:19-23"]},{"l":2,"t":"Gideon","ru":"Гедеон","r":["JDG 8:1-3"]},{"l":2,"t":"David","ru":"Давид","r":["1SA 16:18"]},{"l":2,"t":"Abigail","ru":"Авигея","r":["1SA 25:23-31","2SA 15:32-34","2SA 17:6-14"]},{"l":2,"t":"Aged counsellors of Rehoboam","ru":"Старые советники Ровоама","r":["1KI 12:7"]},{"l":2,"t":"Solomon","ru":"Соломон","r":["2CH 2:12"]},{"l":2,"t":"Nehemiah","ru":"Неемия","r":["NEH 2:12-16","NEH 4:13-18"]},{"l":2,"t":"The Poor Wise Man","ru":"Бедный мудрый человек","r":["ECC 9:15"]},{"l":2,"t":"The Scribe","ru":"Книжник","r":["MRK 12:32-34"]},{"l":2,"t":"Gamaliel","ru":"Гамалиил","r":["ACT 5:34-39"]},{"l":2,"t":"Sergius Paulus","ru":"Сергий Павел","r":["ACT 13:7"]},{"l":2,"t":"Paul","ru":"Павел","r":["ACT 23:6"]}]}
