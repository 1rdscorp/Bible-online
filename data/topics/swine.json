{"id":"swine","en":"Swine","ru":"Свиньи","lines":[{"l":1,"t":"When wild inhabited the woods","ru":"Дикие жили в лесах","r":["PSA 80:13"]},{"l":1,"t":"Unclean and not to be eaten","ru":"Нечисты, и есть их запрещено","r":["LEV 11:7","LEV 11:8"]},{"l":1,"t":"Described","ru":"Описываются как:","r":[]},{"l":2,"t":"Fierce and ungenerous","ru":"Свирепые и неблагодарные","r":["MAT 7:6"]},{"l":2,"t":"Filthy in its habits","ru":"Нечистоплотные","r":["2PE 2:22"]},{"l":2,"t":"Destructive to agriculture","ru":"Вредящие земледелию","r":["PSA 80:13"]},{"l":1,"t":"Fed upon husks","ru":"Питались рожками","r":["LUK 15:16"]},{"l":1,"t":"Sacrificing of, and abomination","ru":"Принесение их в жертву — мерзость","r":["ISA 66:3"]},{"l":1,"t":"Kept in large herds","ru":"Содержались большими стадами","r":["MAT 8:30"]},{"l":1,"t":"Herding of, considered as the greatest degradation to a Jew","ru":"Пасти их считалось для иудея крайним унижением","r":["LUK 15:15"]},{"l":1,"t":"The Gergesenes punished for having","ru":"Гергесинцы наказаны за то, что держали их","r":["MAT 8:31","MAT 8:32","MRK 5:11","MRK 5:14"]},{"l":1,"t":"The ungodly Jews condemned for eating","ru":"Нечестивые иудеи осуждены за то, что ели их мясо","r":["ISA 65:4","ISA 66:17"]},{"l":1,"t":"Illustrative of","ru":"Образ:","r":[]},{"l":2,"t":"The wicked","ru":"Нечестивых","r":["MAT 7:6"]},{"l":2,"t":"Hypocrites","ru":"Лицемеров","r":["2PE 2:22"]}]}
