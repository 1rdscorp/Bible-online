{"id":"hivites","en":"Hivites","ru":"Евеи","lines":[{"l":1,"t":"Descended from Canaan","ru":"Произошли от Ханаана","r":["GEN 10:15","GEN 10:17"]},{"l":1,"t":"Supposed to be the ancient Avim, or Avites","ru":"Предположительно, древние аввеи","r":["DEU 2:33","JOS 13:3"]},{"l":1,"t":"One of the seven nations of Canaan","ru":"Один из семи народов Ханаана","r":["DEU 7:1"]},{"l":1,"t":"Dwelt near Lebanon","ru":"Жили близ Ливана","r":["JDG 3:3"]},{"l":1,"t":"The Shechemites a people of","ru":"Сихемляне — из евеев","r":["GEN 34:2"]},{"l":1,"t":"The Gibeonites a people of","ru":"Гаваонитяне — из евеев","r":["JOS 9:3","JOS 9:7"]},{"l":1,"t":"Esau intermarried with","ru":"Исав взял жену из них","r":["GEN 36:2"]},{"l":1,"t":"Land of, promised to Israel","ru":"Земля их обещана Израилю","r":["EXO 3:8","EXO 23:23"]},{"l":1,"t":"Israel commanded to destroy","ru":"Израилю повелено истребить их","r":["DEU 7:1","DEU 7:2","DEU 7:24"]},{"l":1,"t":"A part of, left to prove Israel","ru":"Часть их оставлена для испытания Израиля","r":["JDG 3:3"]},{"l":1,"t":"Remnant of, made tributary in the reign of Solomon","ru":"Остаток их обложен данью при Соломоне","r":["1KI 9:20","1KI 9:21"]}]}
