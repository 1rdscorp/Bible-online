{"id":"watchmen","en":"Watchmen","ru":"Стражи","lines":[{"l":1,"t":"Soldiers generally acted as","r":["MAT 27:65","MAT 27:66"]},{"l":1,"t":"Citizens sometimes acted as","r":["NEH 7:3"]},{"l":1,"t":"Were stationed","r":[]},{"l":2,"t":"On watch towers","r":["2KI 9:17","ISA 21:5"]},{"l":2,"t":"On the walls of cities","r":["ISA 62:6"]},{"l":2,"t":"In the streets of cities","r":["PSA 127:1"]},{"l":2,"t":"Around the temple in Jerusalem on special occasions","r":["2KI 11:6"]},{"l":1,"t":"Paraded the streets at night to preserve order","r":["SNG 3:3","SNG 5:7"]},{"l":1,"t":"In time of danger","r":[]},{"l":2,"t":"Increase in number","r":["JER 51:12"]},{"l":2,"t":"Vigilant night and day","r":["NEH 4:9","ISA 21:8"]},{"l":2,"t":"Reported the approach of all strangers","r":["2SA 18:24-27","2KI 9:18-20","ISA 21:6","ISA 21:7","ISA 21:9"]},{"l":2,"t":"Sounded an alarm at the approach of enemies","r":["EZK 33:2","EZK 33:3"]},{"l":1,"t":"Vigilance of, vain without God’s protection","r":["PSA 127:1"]},{"l":1,"t":"Were relieved by turns","r":["NEH 7:3"]},{"l":1,"t":"Danger of sleeping on their posts, referred to","r":["MAT 28:13","MAT 28:14"]},{"l":1,"t":"Neglecting to give warning punished with death","r":["EZK 33:6"]},{"l":1,"t":"Often interrogated by passengers","r":["ISA 21:11"]},{"l":1,"t":"Illustrative","r":[]},{"l":2,"t":"Of ministers","r":["ISA 5:28","ISA 62:6","EZK 3:17","HEB 13:17"]},{"l":2,"t":"(Blind,) of careless ministers","r":["ISA 56:10"]},{"l":2,"t":"(Looking for the morning,) of anxious waiting for God","r":["PSA 130:5","PSA 130:6"]}]}
