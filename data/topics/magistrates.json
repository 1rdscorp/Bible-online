{"id":"magistrates","en":"Magistrates","ru":"Начальники и правители","lines":[{"l":1,"t":"Are appointed by God","r":["ROM 13:1"]},{"l":1,"t":"Are ministers of God","r":["ROM 13:4","ROM 13:6"]},{"l":1,"t":"Purpose of their appointment","r":["ROM 13:4","1PE 2:14"]},{"l":1,"t":"Their office to be respected","r":["ACT 23:5"]},{"l":1,"t":"Are not a terror to the good, but to the evil","r":["ROM 13:3"]},{"l":1,"t":"To be wisely selected and appointed","r":["EXO 18:21","EZR 7:25"]},{"l":1,"t":"To be prayed for","r":["1TI 2:1","1TI 2:2"]},{"l":1,"t":"Should","r":[]},{"l":2,"t":"Seek wisdom from God","r":["1KI 3:9"]},{"l":2,"t":"Rule in the fear of God","r":["2SA 23:3","2CH 19:7"]},{"l":2,"t":"Know the law of God","r":["EZR 7:25"]},{"l":2,"t":"Be faithful to the Sovereign","r":["DAN 6:4"]},{"l":2,"t":"Enforce the laws","r":["EZR 7:26"]},{"l":2,"t":"Judge wisely","r":["1KI 3:16-28"]},{"l":2,"t":"Hate covetousness","r":["EXO 18:21"]},{"l":2,"t":"Not take bribes","r":["EXO 23:8","DEU 16:19"]},{"l":2,"t":"Defend the poor","r":["JOB 29:12","JOB 29:16"]},{"l":2,"t":"Judge for God, not for man","r":["2CH 19:6"]},{"l":2,"t":"Judge righteously","r":["DEU 1:16","DEU 16:18","DEU 25:1"]},{"l":2,"t":"Be impartial","r":["EXO 23:6","DEU 1:17"]},{"l":2,"t":"Be diligent in ruling","r":["ROM 12:8"]},{"l":2,"t":"Subjection to their authority enjoined","r":["MAT 23:2","MAT 23:3","ROM 13:1","1PE 2:13","1PE 2:14"]},{"l":1,"t":"Wicked","r":["PRO 28:15"]},{"l":1,"t":"Good","r":[]},{"l":2,"t":"Joseph","r":["GEN 41:46"]},{"l":2,"t":"Gideon","r":["JDG 8:35"]},{"l":2,"t":"Samuel","r":["1SA 12:3","1SA 12:4","EZR 10:1-9"]},{"l":2,"t":"Nehemiah","r":["NEH 3:15"]},{"l":2,"t":"Job","r":["JOB 29:16"]},{"l":2,"t":"Daniel","r":["DAN 6:3"]},{"l":1,"t":"Wicked","r":[]},{"l":2,"t":"Sons of Samuel","r":["1SA 8:3"]},{"l":2,"t":"Pilate","r":["MAT 27:24","MAT 27:26"]},{"l":2,"t":"Magistrates in Philippi","r":["ACT 16:22","ACT 16:23"]},{"l":2,"t":"Gallio","r":["ACT 18:16","ACT 18:17"]},{"l":2,"t":"Felix","r":["ACT 24:26"]}]}
