{"id":"death-of-the-wicked","en":"Death of the Wicked","ru":"Смерть нечестивых","lines":[{"l":1,"t":"Is in their sins","ru":"Во грехах своих","r":["EZK 3:19","JHN 8:21"]},{"l":1,"t":"Is without hope","ru":"Без надежды","r":["PRO 11:7"]},{"l":1,"t":"Sometimes without fear","ru":"Иногда без страха","r":["JER 34:5","2CH 36:11-13"]},{"l":1,"t":"Frequently sudden and unexpected","ru":"Часто внезапна и неожиданна","r":["JOB 21:13","JOB 21:23","JOB 27:21","PRO 29:1"]},{"l":1,"t":"Frequently marked by terror","ru":"Часто исполнена ужаса","r":["JOB 18:11-15","JOB 27:19-21","PSA 73:19"]},{"l":1,"t":"Punishment follows","ru":"За ней следует наказание","r":["ISA 14:9","ACT 1:25"]},{"l":1,"t":"The remembrance of them perishes in","ru":"С ней исчезает память о них","r":["JOB 18:17","PSA 34:16","PRO 10:7"]},{"l":1,"t":"God has no pleasure in","ru":"Бог не желает её","r":["EZK 18:23","EZK 18:32"]},{"l":1,"t":"Like the death of beasts","ru":"Подобна смерти скотов","r":["PSA 49:14"]},{"l":1,"t":"Illustrated","ru":"Притчи и образы","r":["LUK 12:20","LUK 16:22","LUK 16:23"]},{"l":1,"t":"Exemplified","ru":"Примеры:","r":[]},{"l":2,"t":"Korah, &c","ru":"Корей и т. д.","r":["NUM 16:32"]},{"l":2,"t":"Absalom","ru":"Авессалом","r":["2SA 18:9","2SA 18:10"]},{"l":2,"t":"Ahab","ru":"Ахав","r":["1KI 22:34"]},{"l":2,"t":"Jezebel","ru":"Иезавель","r":["2KI 9:33"]},{"l":2,"t":"Athaliah","ru":"Гофолия","r":["2CH 23:15"]},{"l":2,"t":"Haman","ru":"Аман","r":["EST 7:10"]},{"l":2,"t":"Belshazzar","ru":"Валтасар","r":["DAN 5:30"]},{"l":2,"t":"Judas","ru":"Иуда","r":["MAT 27:5","ACT 1:18"]},{"l":2,"t":"Ananias, &c","ru":"Анания и т. д.","r":["ACT 5:5","ACT 5:9","ACT 5:10"]},{"l":2,"t":"Herod","ru":"Ирод","r":["ACT 12:23"]}]}
