{"id":"sackcloth","en":"Sackcloth","ru":"Вретище","lines":[{"l":1,"t":"Made of coarse hair","ru":"Делалось из грубого волоса","r":["MAT 3:4","REV 6:12"]},{"l":1,"t":"Rough and unsightly","ru":"Было грубым и неприглядным","r":["ZEC 13:4"]},{"l":1,"t":"Of a black colour","ru":"Чёрного цвета","r":["REV 6:12"]},{"l":1,"t":"Was worn","ru":"Носилось:","r":[]},{"l":2,"t":"By God’s prophets","ru":"Пророками Божиими","r":["2KI 1:8","ISA 20:2","MAT 3:4","REV 11:3"]},{"l":2,"t":"By persons in affliction","ru":"Людьми в скорби","r":["NEH 9:1","PSA 69:11","JON 3:5"]},{"l":2,"t":"Girt about the loins","ru":"Препоясанным по чреслам","r":["GEN 37:34","1KI 20:31"]},{"l":2,"t":"Frequently next the skin in deep afflictions","ru":"Часто прямо на теле в глубокой скорби","r":["1KI 21:27","2KI 6:30","JOB 16:15"]},{"l":2,"t":"Often over the whole person","ru":"Часто покрывая всё тело","r":["2KI 19:1","2KI 19:2"]},{"l":2,"t":"With ashes on the head","ru":"С пеплом на голове","r":["EST 4:1"]},{"l":2,"t":"Often with ropes on the head","ru":"Часто с верёвками на голове","r":["1KI 20:31"]},{"l":2,"t":"In the streets","ru":"На улицах","r":["ISA 15:3"]},{"l":2,"t":"At funerals","ru":"При погребении","r":["2SA 3:31"]},{"l":1,"t":"The Jews lay in, when in deep affliction","ru":"Иудеи в глубокой скорби лежали на вретище","r":["2SA 21:10","1KI 21:27","JOL 1:13"]},{"l":1,"t":"No one clothed in, allowed into the palaces of kings","ru":"Никому, одетому во вретище, не дозволялось входить в царские чертоги","r":["EST 4:2"]},{"l":1,"t":"Illustrative","ru":"Образ:","r":[]},{"l":2,"t":"(Girding with,) of heavy afflictions","ru":"(Препоясание вретищем) тяжких скорбей","r":["ISA 3:24","ISA 22:12","ISA 32:11"]},{"l":2,"t":"(Covering the heavens with,) of severe judgments","ru":"(Покрытие небес вретищем) тяжких судов","r":["ISA 50:3"]},{"l":2,"t":"(Heavens becoming as,) of severe judgments","ru":"(Небеса, ставшие как вретище) тяжких судов","r":["REV 6:12"]},{"l":2,"t":"(Putting of,) of joy and gladness","ru":"(Снятие вретища) радости и веселья","r":["PSA 30:11"]}]}
