raham","ru":"Авраам","r":["GEN 18:19"]},{"l":2,"t":"Jacob","ru":"Иаков","r":["GEN 35:2"]},{"l":2,"t":"Joshua","ru":"Иисус Навин","r":["JOS 24:15"]},{"l":2,"t":"Centurion","ru":"Сотник","r":["LUK 7:2","LUK 7:3"]},{"l":2,"t":"Cornelius","ru":"Корнилий","r":["ACT 10:2"]},{"l":1,"t":"Bad","ru":"Примеры злых господ:","r":[]},{"l":2,"t":"Egyptians","ru":"Египтяне","r":["EXO 1:13","EXO 1:14"]},{"l":2,"t":"Nabal","ru":"Навал","r":["1SA 25:17"]},{"l":2,"t":"Amalekite","ru":"Амаликитянин","r":["1SA 30:13"]}]}
