{"id":"parents","en":"Parents","ru":"Родители","lines":[{"l":1,"t":"Receive their children from God","r":["GEN 33:5","1SA 1:27","PSA 127:3"]},{"l":1,"t":"Their duty to their children is","r":[]},{"l":2,"t":"To love them","r":["TIT 2:4"]},{"l":2,"t":"To bring them to Christ","r":["MAT 19:13","MAT 19:14"]},{"l":2,"t":"To train them up for God","r":["PRO 22:6","EPH 6:4"]},{"l":2,"t":"To instruct them in God’s word","r":["DEU 4:9","DEU 11:19","ISA 38:19"]},{"l":2,"t":"To tell them of God’s judgments","r":["JOL 1:3"]},{"l":2,"t":"To tell them of the miraculous works of God","r":["EXO 10:2","PSA 78:4"]},{"l":2,"t":"To command them to obey God","r":["DEU 32:46","1CH 28:9"]},{"l":2,"t":"To bless them","r":["GEN 48:15","HEB 11:20"]},{"l":2,"t":"To pity them","r":["PSA 103:13"]},{"l":2,"t":"To provide for them","r":["JOB 42:15","2CO 12:14","1TI 5:8"]},{"l":2,"t":"To rule them","r":["1TI 3:4","1TI 3:12"]},{"l":2,"t":"To correct them","r":["PRO 13:24","PRO 19:18","PRO 23:13","PRO 29:17","HEB 12:7"]},{"l":2,"t":"Not to provoke them","r":["EPH 6:4","COL 3:21"]},{"l":2,"t":"Not to make unholy connections for them","r":["GEN 24:1-4","GEN 28:1","GEN 28:2"]},{"l":1,"t":"Wicked children, a cause of grief to","r":["PRO 10:1","PRO 17:25"]},{"l":1,"t":"Should pray for their children","r":[]},{"l":2,"t":"For their spiritual welfare","r":["GEN 17:18","1CH 29:19"]},{"l":2,"t":"When in temptation","r":["JOB 1:5"]},{"l":2,"t":"When in sickness","r":["2SA 12:16","MRK 5:23","JHN 4:46","JHN 4:49"]},{"l":1,"t":"When Faithful","r":[]},{"l":2,"t":"Are blessed by their children","r":["PRO 31:28"]},{"l":2,"t":"Leave a blessing to their children","r":["PSA 112:2","PRO 11:21","ISA 65:23"]},{"l":1,"t":"Sins of, visited on their children","r":["EXO 20:5","ISA 14:20","LAM 5:7"]},{"l":1,"t":"Negligence of, sorely punished","r":["1SA 3:13"]},{"l":1,"t":"When wicked","r":[]},{"l":2,"t":"Instruct their children in evil","r":["JER 9:14","1PE 1:18"]},{"l":2,"t":"Set a bad example to their children","r":["EZK 20