{"id":"beard","en":"Beard","ru":"Борода","lines":[{"l":1,"t":"The Jews never appeared without","r":["2SA 10:5"]},{"l":1,"t":"Worn even by the priests","r":["PSA 133:2"]},{"l":1,"t":"Laying hold of, a token of respect","r":["1SA 20:9"]},{"l":1,"t":"Shaving of, a great offence","r":["2SA 10:4","2SA 10:6","2SA 10:7"]},{"l":1,"t":"Plucking of, a sign of scorn","r":["ISA 50:6"]},{"l":1,"t":"Dribbling on, a sign of derangement","r":["1SA 21:13"]},{"l":1,"t":"In affliction","r":[]},{"l":2,"t":"Was neglected and untrimmed","r":["2SA 19:24"]},{"l":2,"t":"Was clipped","r":["JER 48:37"]},{"l":2,"t":"Was shorn","r":["JER 41:5"]},{"l":2,"t":"Sometimes plucked out","r":["EZR 9:3"]},{"l":1,"t":"Corners of, not to be marred for the dead","r":["LEV 19:27","LEV 21:5"]},{"l":1,"t":"Subject to leprosy","r":["LEV 13:29","LEV 13:30"]},{"l":1,"t":"Of the healed leper to be shaved","r":["LEV 14:9"]},{"l":1,"t":"Shaving, illustrative of severe judgments","r":["ISA 7:20","ISA 15:2","EZK 5:1"]}]}
