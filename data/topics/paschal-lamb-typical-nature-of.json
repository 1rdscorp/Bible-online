{"id":"paschal-lamb-typical-nature-of","en":"Paschal Lamb, Typical Nature Of","ru":"Пасхальный агнец как прообраз","lines":[{"l":1,"t":"A type of Christ","ru":"Прообраз Христа","r":["EXO 12:3","1CO 5:7"]},{"l":1,"t":"A male of the first year","ru":"Агнец мужского пола, однолетний","r":["EXO 12:5","ISA 9:6"]},{"l":1,"t":"Without blemish","ru":"Без порока","r":["EXO 12:5","1PE 1:19"]},{"l":1,"t":"Taken out of the flock","ru":"Взят из стада","r":["EXO 12:5","HEB 2:14","HEB 2:17"]},{"l":1,"t":"Chosen before-hand","ru":"Избирался заранее","r":["EXO 12:3","1PE 2:4"]},{"l":1,"t":"Shut up four days that it might be closely examined","ru":"Хранился четыре дня, чтобы его тщательно осмотреть","r":["EXO 12:6","JHN 8:46","JHN 18:38"]},{"l":1,"t":"Killed by the people","ru":"Закалался народом","r":["EXO 12:6","ACT 2:23"]},{"l":1,"t":"Killed at the place where the Lord put his name","ru":"Закалался на месте, которое избрал Господь, чтобы пребывало там имя Его","r":["DEU 16:2","DEU 16:5-7","2CH 35:1","LUK 13:33"]},{"l":1,"t":"Killed in the evening","ru":"Закалался вечером","r":["EXO 12:6","MRK 15:34","MRK 15:37"]},{"l":1,"t":"Its blood to be shed","ru":"Кровь его должна была быть пролита","r":["EXO 12:7","LUK 22:20"]},{"l":1,"t":"Blood of, sprinkled on lintel and door-posts","ru":"Кровью его мазали перекладину и косяки дверей","r":["EXO 12:22","HEB 9:13","HEB 9:14","HEB 10:22","1PE 1:2"]},{"l":1,"t":"Blood of, not sprinkled on threshold","ru":"Кровью его не мазали порог","r":["EXO 12:7","HEB 10:29"]},{"l":1,"t":"Not a bone of, broken","ru":"Кость его не сокрушалась","r":["EXO 12:46","JHN 19:36"]},{"l":1,"t":"Not eaten raw","ru":"Не ели его недопечённым","r":["EXO 12:9","1CO 11:28","1CO 11:29"]},{"l":1,"t":"Roasted with fire","ru":"Испекался на огне","r":["EXO 12:8","PSA 22:14","PSA 22:15"]},{"l":1,"t":"Eaten with bitter herbs","ru":"Ели его с горькими травами","r":["EXO 12:8","ZEC 12:10"]},{"l":1,"t":"Eaten with unleavened bread","ru":"Ели его с опресноками","r":["EXO 12:39","1CO 5:7","1CO 5:8","2CO 1:12"]},{"l":1,"t":"Eaten in haste","ru":"Ели его с поспешностью","r":["EXO 12:11","HEB 6:18"]},{"l":1,"t":"Eaten with the loins girt","ru":"Ели его препоясавшись","r":["EXO 12:11","LUK 12:35","EPH 6:14","1PE 1:13"]},{"l":1,"t":"Eaten with staff in hand","ru":"Ели его с посохом в руке","r":["EXO 12:11","PSA 23:4"]},{"l":1,"t":"Eaten with shoes on","ru":"Ели его в обуви","r":["EXO 12:11","EPH 6:15"]},{"l":1,"t":"Not taken out of the house","ru":"Не выносился из дома","r":["EXO 12:46","EPH 3:17"]},{"l":1,"t":"What remained of it till morning to be burned","ru":"Оставшееся до утра сжигалось","r":["EXO 12:10","MAT 7:6","LUK 11:3"]}]}
