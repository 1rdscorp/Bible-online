{"id":"pharisees","en":"Pharisees","ru":"Фарисеи","lines":[{"l":1,"t":"A sect of the Jews","r":["ACT 15:5"]},{"l":1,"t":"The strictest observers of the Mosaic ritual","r":["ACT 26:5"]},{"l":1,"t":"By descent, especially esteemed","r":["ACT 23:6"]},{"l":1,"t":"Character of","r":[]},{"l":2,"t":"Zealous of the law","r":["ACT 15:5","PHP 3:5"]},{"l":2,"t":"Zealous of tradition","r":["MRK 7:3","MRK 7:5-8","GAL 1:14"]},{"l":2,"t":"Outwardly moral","r":["LUK 18:11","PHP 3:5","PHP 3:6"]},{"l":2,"t":"Rigid in fasting","r":["LUK 5:33","LUK 18:12"]},{"l":2,"t":"Active in proselytising","r":["MAT 23:15"]},{"l":2,"t":"Self-righteous","r":["LUK 16:15","LUK 18:9"]},{"l":2,"t":"Avaricious","r":["MAT 23:14","LUK 16:14"]},{"l":2,"t":"Ambitious of precedence","r":["MAT 23:6"]},{"l":2,"t":"Fond of public salutations","r":["MAT 23:7"]},{"l":2,"t":"Fond of distinguished titles","r":["MAT 23:7-10"]},{"l":2,"t":"Particular in paying all dues","r":["MAT 23:23"]},{"l":2,"t":"Oppressive","r":["MAT 23:4"]},{"l":2,"t":"Cruel in persecuting","r":["ACT 9:1","ACT 9:2"]},{"l":1,"t":"Believed in the resurrection &c","r":["ACT 23:8"]},{"l":1,"t":"Made broad their phylacteries","r":["MAT 23:5"]},{"l":1,"t":"Their opinions, a standard for others","r":["JHN 7:48"]},{"l":1,"t":"Many priest and Levites were of","r":["JHN 1:19","JHN 1:24"]},{"l":1,"t":"Many rulers, lawyers, and scribes were of","r":["JHN 3:1","ACT 5:34","ACT 23:9"]},{"l":1,"t":"Had disciples","r":["LUK 5:33","ACT 22:3"]},{"l":1,"t":"Some came to John for baptism","r":["MAT 3:7"]},{"l":1,"t":"As a body, rejected John’s baptism","r":["LUK 7:30"]},{"l":1,"t":"Christ","r":[]},{"l":2,"t":"Often invited by","r":["LUK 7:36","LUK 11:37"]},{"l":2,"t":"Condemned by, for associating with sinners","r":["MAT 9:11","LUK 7:39","LUK 15:1","LUK 15:2"]},{"l":2,"t":"Asked for signs by","r":["MAT 12:38","MAT 16:1"]},{"l":2,"t":"Tempted by, with questions about the law","r":["MAT 19:3","MAT 22:15","MAT 22:16","MAT 22:35"]},{"l":2,"t":"Watched by, for evil","r":["LUK 6:7"]},{"l":2,"t":"Offended, by his doctrine","r":["MAT 15:12","MAT 21:45","LUK 16:14"]},{"l":2,"t":"Declared the imaginary righteousness of, to be insufficient for salvation","r":["MAT 5:20"]},{"l":2,"t":"Declared the doctrines of, to be hypocrisy","r":["MAT 16:6","MAT 16:11","MAT 16:12","LUK 12:1"]},{"l":2,"t":"Denounced woes against","r":["MAT 23:13-33"]},{"l":2,"t":"Called, and evil and adulterous generation","r":["MAT 12:39"]},{"l":2,"t":"Called, serpents and generation of vipers","r":["MAT 23:33"]},{"l":2,"t":"Called fools and blind guides","r":["MAT 23:17","MAT 23:24"]},{"l":2,"t":"Compared, to whited sepulchres","r":["MAT 23:27"]},{"l":2,"t":"Compared, to graves that appear not","r":["LUK 11:44"]},{"l":2,"t":"Left Judea for a time on account of","r":["JHN 4:1-3"]},{"l":1,"t":"Imputed Christ’s miracles to Satan’s power","r":["MAT 9:34","MAT 12:24"]},{"l":1,"t":"Sent officers to apprehend Christ","r":["JHN 7:32","JHN 7:45"]},{"l":1,"t":"Often sought to destroy Christ","r":["MAT 12:14","MAT 21:46","JHN 11:47","JHN 11:53","JHN 11:57"]}]}
