{"id":"pharisees","en":"Pharisees","ru":"Фарисеи","lines":[{"l":1,"t":"A sect of the Jews","ru":"Иудейская секта","r":["ACT 15:5"]},{"l":1,"t":"The strictest observers of the Mosaic ritual","ru":"Строжайшие соблюдатели обрядов Моисеевых","r":["ACT 26:5"]},{"l":1,"t":"By descent, especially esteemed","ru":"Происхождение от фарисеев особо почиталось","r":["ACT 23:6"]},{"l":1,"t":"Character of","ru":"Их характер:","r":[]},{"l":2,"t":"Zealous of the law","ru":"Ревностны к закону","r":["ACT 15:5","PHP 3:5"]},{"l":2,"t":"Zealous of tradition","ru":"Ревностны к преданиям","r":["MRK 7:3","MRK 7:5-8","GAL 1:14"]},{"l":2,"t":"Outwardly moral","ru":"Внешне нравственны","r":["LUK 18:11","PHP 3:5","PHP 3:6"]},{"l":2,"t":"Rigid in fasting","ru":"Строги в постах","r":["LUK 5:33","LUK 18:12"]},{"l":2,"t":"Active in proselytising","ru":"Усердны в обращении прозелитов","r":["MAT 23:15"]},{"l":2,"t":"Self-righteous","ru":"Самоправедны","r":["LUK 16:15","LUK 18:9"]},{"l":2,"t":"Avaricious","ru":"Сребролюбивы","r":["MAT 23:14","LUK 16:14"]},{"l":2,"t":"Ambitious of precedence","ru":"Любят первенство","r":["MAT 23:6"]},{"l":2,"t":"Fond of public salutations","ru":"Любят приветствия в народных собраниях","r":["MAT 23:7"]},{"l":2,"t":"Fond of distinguished titles","ru":"Любят почётные звания","r":["MAT 23:7-10"]},{"l":2,"t":"Particular in paying all dues","ru":"Тщательны в уплате всех десятин","r":["MAT 23:23"]},{"l":2,"t":"Oppressive","ru":"Притеснители","r":["MAT 23:4"]},{"l":2,"t":"Cruel in persecuting","ru":"Жестоки в гонениях","r":["ACT 9:1","ACT 9:2"]},{"l":1,"t":"Believed in the resurrection &c","ru":"Веровали в воскресение и т. д.","r":["ACT 23:8"]},{"l":1,"t":"Made broad their phylacteries","ru":"Расширяли хранилища свои","r":["MAT 23:5"]},{"l":1,"t":"Their opinions, a standard for others","ru":"Их мнения — образец для других","r":["JHN 7:48"]},{"l":1,"t":"Many priest and Levites were of","ru":"Многие священники и левиты принадлежали к ним","r":["JHN 1:19","JHN 1:24"]},{"l":1,"t":"Many rulers, lawyers, and scribes were of","ru":"Многие начальники, законники и книжники принадлежали к ним","r":["JHN 3:1","ACT 5:34","ACT 23:9"]},{"l":1,"t":"Had disciples","ru":"Имели учеников","r":["LUK 5:33","ACT 22:3"]},{"l":1,"t":"Some came to John for baptism","ru":"Некоторые приходили к Иоанну креститься","r":["MAT 3:7"]},{"l":1,"t":"As a body, rejected John’s baptism","ru":"В целом отвергли крещение Иоанна","r":["LUK 7:30"]},{"l":1,"t":"Christ","ru":"Фарисеи и Христос:","r":[]},{"l":2,"t":"Often invited by","ru":"Часто приглашали Его","r":["LUK 7:36","LUK 11:37"]},{"l":2,"t":"Condemned by, for associating with sinners","ru":"Осуждали Его за общение с грешниками","r":["MAT 9:11","LUK 7:39","LUK 15:1","LUK 15:2"]},{"l":2,"t":"Asked for signs by","ru":"Просили у Него знамений","r":["MAT 12:38","MAT 16:1"]},{"l":2,"t":"Tempted by, with questions about the law","ru":"Искушали Его вопросами о законе","r":["MAT 19:3","MAT 22:15","MAT 22:16","MAT 22:35"]},{"l":2,"t":"Watched by, for evil","ru":"Подстерегали Его со злым умыслом","r":["LUK 6:7"]},{"l":2,"t":"Offended, by his doctrine","ru":"Соблазнялись Его учением","r":["MAT 15:12","MAT 21:45","LUK 16:14"]},{"l":2,"t":"Declared the imaginary righteousness of, to be insufficient for salvation","ru":"Он объявил их мнимую праведность недостаточной для спасения","r":["MAT 5:20"]},{"l":2,"t":"Declared the doctrines of, to be hypocrisy","ru":"Он назвал их учение лицемерием","r":["MAT 16:6","MAT 16:11","MAT 16:12","LUK 12:1"]},{"l":2,"t":"Denounced woes against","ru":"Он изрёк на них горе","r":["MAT 23:13-33"]},{"l":2,"t":"Called, and evil and adulterous generation","ru":"Он назвал их родом лукавым и прелюбодейным","r":["MAT 12:39"]},{"l":2,"t":"Called, serpents and generation of vipers","ru":"Он назвал их змиями, порождениями ехидниными","r":["MAT 23:33"]},{"l":2,"t":"Called fools and blind guides","ru":"Он назвал их безумными и слепыми вождями","r":["MAT 23:17","MAT 23:24"]},{"l":2,"t":"Compared, to whited sepulchres","ru":"Он уподобил их окрашенным гробам","r":["MAT 23:27"]},{"l":2,"t":"Compared, to graves that appear not","ru":"Он уподобил их скрытым гробам","r":["LUK 11:44"]},{"l":2,"t":"Left Judea for a time on account of","ru":"Он на время оставил из-за них Иудею","r":["JHN 4:1-3"]},{"l":1,"t":"Imputed Christ’s miracles to Satan’s power","ru":"Приписывали чудеса Христа силе сатаны","r":["MAT 9:34","MAT 12:24"]},{"l":1,"t":"Sent officers to apprehend Christ","ru":"Посылали служителей схватить Христа","r":["JHN 7:32","JHN 7:45"]},{"l":1,"t":"Often sought to destroy Christ","ru":"Часто искали погубить Христа","r":["MAT 12:14","MAT 21:46","JHN 11:47","JHN 11:53","JHN 11:57"]}]}
