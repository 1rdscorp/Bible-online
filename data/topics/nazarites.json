{"id":"nazarites","en":"Nazarites","ru":"Назореи","lines":[{"l":1,"t":"Persons separated to the service of God","ru":"Люди, отделённые на служение Богу","r":["NUM 6:2"]},{"l":1,"t":"Different kinds of","ru":"Различные виды:","r":[]},{"l":2,"t":"From the womb","ru":"От чрева матери","r":["JDG 13:5","LUK 1:15"]},{"l":2,"t":"By a particular vow","ru":"По особому обету","r":["NUM 6:2"]},{"l":1,"t":"Required to be holy","ru":"Должны быть святы","r":["NUM 6:8"]},{"l":1,"t":"Esteemed pure","ru":"Почитались чистыми","r":["LAM 4:7"]},{"l":1,"t":"Prohibited from","ru":"Им запрещалось:","r":[]},{"l":2,"t":"Wine or strong drink","ru":"Вино и сикера","r":["NUM 6:3","LUK 1:15"]},{"l":2,"t":"Grapes or anything made from the vine","ru":"Виноград и всё, что делается из виноградной лозы","r":["NUM 6:3","NUM 6:4","JDG 13:14"]},{"l":2,"t":"Cutting or shaving the head","ru":"Стричь или брить голову","r":["NUM 6:5","JDG 13:5","JDG 16:17"]},{"l":2,"t":"Defiling themselves by the dead","ru":"Оскверняться прикосновением к мёртвому","r":["NUM 6:6","NUM 6:7"]},{"l":1,"t":"Raised up for good of the nation","ru":"Воздвигались на благо народа","r":["AMO 2:11"]},{"l":1,"t":"Ungodly Jews tried to corrupt","ru":"Нечестивые иудеи пытались их совратить","r":["AMO 2:12"]},{"l":1,"t":"Defiled during vow","ru":"Осквернившиеся во время обета должны были:","r":[]},{"l":2,"t":"To shave the head the seventh day","ru":"Обрить голову в седьмой день","r":["NUM 6:9"]},{"l":2,"t":"To bring two turtle doves for a burnt offering","ru":"Принести двух горлиц для всесожжения","r":["NUM 6:10","NUM 6:11"]},{"l":2,"t":"To recompense their vow with a trespass offering","ru":"Возобновить свой обет с жертвой повинности","r":["NUM 6:12"]},{"l":1,"t":"On completion of vow","ru":"По исполнении обета должны были:","r":[]},{"l":2,"t":"To be brought to tabernacle door","ru":"Приводиться ко входу скинии","r":["NUM 6:13"]},{"l":2,"t":"To offer sacrifices","ru":"Приносить жертвы","r":["NUM 6:14-17"]},{"l":2,"t":"To shave their heads","ru":"Обривать голову","r":["NUM 6:18","ACT 18:18","ACT 21:24"]},{"l":2,"t":"To have the left shoulder of the ram of the peace offering waved upon their hands by the priest","ru":"Принимать на руки левое плечо овна мирной жертвы, которое священник потрясал","r":["NUM 6:19","NUM 6:20","LEV 7:32"]},{"l":1,"t":"Illustrative of","ru":"Образ:","r":[]},{"l":2,"t":"Christ","ru":"Христа","r":["HEB 7:26"]},{"l":2,"t":"Saints","ru":"Святых","r":["2CO 6:17","JAS 1:27"]}]}
