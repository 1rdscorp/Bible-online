{"id":"counsels-and-purposes-of-god","en":"Counsels and Purposes of God","ru":"Советы и намерения Божии","lines":[{"l":1,"t":"Are great","ru":"Велики","r":["JER 32:19"]},{"l":1,"t":"Are wonderful","ru":"Дивны","r":["ISA 28:29"]},{"l":1,"t":"Are immutable","ru":"Непреложны","r":["PSA 33:11","PRO 19:21","JER 4:28","ROM 9:11","HEB 6:17"]},{"l":1,"t":"Are sovereign","ru":"Владычественны","r":["ISA 40:13","ISA 40:14","DAN 4:35"]},{"l":1,"t":"Are eternal","ru":"Вечны","r":["EPH 3:11"]},{"l":1,"t":"Are faithfulness and truth","ru":"Истинны и верны","r":["ISA 25:1"]},{"l":1,"t":"None can disannul","ru":"Никто не может отменить их","r":["ISA 14:27"]},{"l":1,"t":"Shall be performed","ru":"Исполнятся","r":["ISA 14:24","ISA 46:11"]},{"l":1,"t":"The sufferings and death of Christ were according to","ru":"Страдания и смерть Христа были по ним","r":["ACT 2:23","ACT 4:28"]},{"l":1,"t":"Saints called and save according to","ru":"Святые призваны и спасены по ним","r":["ROM 8:28","2TI 1:9"]},{"l":1,"t":"The union of all saints in Christ, is according to","ru":"Соединение всех святых во Христе — по ним","r":["EPH 1:9","EPH 1:10"]},{"l":1,"t":"The works of God according to","ru":"Дела Божии совершаются по ним","r":["EPH 1:11"]},{"l":1,"t":"Should be declared by ministers","ru":"Служители должны возвещать их","r":["ACT 20:27"]},{"l":1,"t":"Attend to","ru":"Внимать им","r":["JER 49:20","JER 50:45"]},{"l":1,"t":"Secret not to be searched into","ru":"Тайные — не исследовать","r":["DEU 29:29","MAT 24:36","ACT 1:7"]},{"l":1,"t":"The wicked","ru":"Нечестивые:","r":[]},{"l":2,"t":"Understand not","ru":"Не разумеют их","r":["MIC 4:12"]},{"l":2,"t":"Despise","ru":"Презирают их","r":["ISA 5:19"]},{"l":2,"t":"Reject","ru":"Отвергают их","r":["LUK 7:30"]}]}
