{"id":"glory","en":"Glory","ru":"Слава","lines":[{"l":1,"t":"God is, to his people","r":["PSA 3:3","ZEC 2:5"]},{"l":1,"t":"Christ is, to his people","r":["ISA 60:1","LUK 2:32"]},{"l":1,"t":"The gospel ordained to be, to saints","r":["1CO 2:7"]},{"l":1,"t":"Of the gospel, exceeds that of the law","r":["2CO 3:9","2CO 3:10"]},{"l":1,"t":"The joy of saints is full of","r":["1PE 1:8"]},{"l":1,"t":"Spiritual","r":[]},{"l":2,"t":"Is given by God","r":["PSA 84:11"]},{"l":2,"t":"Is given by Christ","r":["JHN 17:22"]},{"l":2,"t":"Christ","r":["JHN 17:22"]},{"l":2,"t":"Is the work of the Holy Spirit","r":["2CO 3:18"]},{"l":1,"t":"Eternal","r":[]},{"l":2,"t":"Procured by the death of Christ","r":["HEB 2:10"]},{"l":2,"t":"Accompanies salvation by Christ","r":["2TI 2:10"]},{"l":2,"t":"Inherited by saints","r":["1SA 2:8","PSA 73:24","PRO 3:35","COL 3:4","1PE 5:10"]},{"l":2,"t":"Saints called to","r":["2TH 2:14","1PE 5:10"]},{"l":2,"t":"Saints afore prepared to","r":["ROM 9:23"]},{"l":2,"t":"Enhanced by present afflictions","r":["2CO 4:17"]},{"l":2,"t":"Present afflictions not worthy to be compared with","r":["ROM 8:18"]},{"l":1,"t":"Of the Church shall be rich and abundant","r":["ISA 60:11-13"]},{"l":1,"t":"The bodies of saints shall be raised in","r":["1CO 15:43","PHP 3:21"]},{"l":1,"t":"Saints shall be, of their ministers","r":["1TH 2:19","1TH 2:20"]},{"l":1,"t":"Temporal","r":[]},{"l":2,"t":"Is given by God","r":["DAN 2:37"]},{"l":2,"t":"Passes away","r":["1PE 1:24"]},{"l":2,"t":"The devil tries to seduce by","r":["MAT 4:8"]},{"l":1,"t":"Of hypocrites turned to shame","r":["HOS 4:7"]},{"l":1,"t":"Seek not, from man","r":["MAT 6:2","1TH 2:6"]},{"l":1,"t":"Of the wicked","r":[]},{"l":2,"t":"Is in their shame","r":["PHP 3:19"]},{"l":2,"t":"Ends in destruction","r":["ISA 5:14"]}]}
