{"id":"glory","en":"Glory","ru":"Слава","lines":[{"l":1,"t":"God is, to his people","ru":"Бог — слава Своего народа","r":["PSA 3:3","ZEC 2:5"]},{"l":1,"t":"Christ is, to his people","ru":"Христос — слава Своего народа","r":["ISA 60:1","LUK 2:32"]},{"l":1,"t":"The gospel ordained to be, to saints","ru":"Евангелие предназначено к славе святых","r":["1CO 2:7"]},{"l":1,"t":"Of the gospel, exceeds that of the law","ru":"Слава Евангелия превосходит славу закона","r":["2CO 3:9","2CO 3:10"]},{"l":1,"t":"The joy of saints is full of","ru":"Радость святых преславна","r":["1PE 1:8"]},{"l":1,"t":"Spiritual","ru":"Духовная слава:","r":[]},{"l":2,"t":"Is given by God","ru":"Даётся Богом","r":["PSA 84:11"]},{"l":2,"t":"Is given by Christ","ru":"Даётся Христом","r":["JHN 17:22"]},{"l":2,"t":"Christ","ru":"Слава Христова дана святым","r":["JHN 17:22"]},{"l":2,"t":"Is the work of the Holy Spirit","ru":"Действие Святого Духа","r":["2CO 3:18"]},{"l":1,"t":"Eternal","ru":"Вечная слава:","r":[]},{"l":2,"t":"Procured by the death of Christ","ru":"Приобретена смертью Христа","r":["HEB 2:10"]},{"l":2,"t":"Accompanies salvation by Christ","ru":"Сопутствует спасению во Христе","r":["2TI 2:10"]},{"l":2,"t":"Inherited by saints","ru":"Наследуется святыми","r":["1SA 2:8","PSA 73:24","PRO 3:35","COL 3:4","1PE 5:10"]},{"l":2,"t":"Saints called to","ru":"Святые призваны к ней","r":["2TH 2:14","1PE 5:10"]},{"l":2,"t":"Saints afore prepared to","ru":"Святые заранее приготовлены к ней","r":["ROM 9:23"]},{"l":2,"t":"Enhanced by present afflictions","ru":"Умножается нынешними скорбями","r":["2CO 4:17"]},{"l":2,"t":"Present afflictions not worthy to be compared with","ru":"Нынешние скорби ничего не стоят в сравнении с ней","r":["ROM 8:18"]},{"l":1,"t":"Of the Church shall be rich and abundant","ru":"Слава Церкви будет богатой и обильной","r":["ISA 60:11-13"]},{"l":1,"t":"The bodies of saints shall be raised in","ru":"Тела святых воскреснут в славе","r":["1CO 15:43","PHP 3:21"]},{"l":1,"t":"Saints shall be, of their ministers","ru":"Святые будут славой своих служителей","r":["1TH 2:19","1TH 2:20"]},{"l":1,"t":"Temporal","ru":"Временная слава:","r":[]},{"l":2,"t":"Is given by God","ru":"Даётся Богом","r":["DAN 2:37"]},{"l":2,"t":"Passes away","ru":"Проходит","r":["1PE 1:24"]},{"l":2,"t":"The devil tries to seduce by","ru":"Ею диавол пытается соблазнить","r":["MAT 4:8"]},{"l":1,"t":"Of hypocrites turned to shame","ru":"Слава лицемеров обратится в посрамление","r":["HOS 4:7"]},{"l":1,"t":"Seek not, from man","ru":"Не искать славы от людей","r":["MAT 6:2","1TH 2:6"]},{"l":1,"t":"Of the wicked","ru":"Слава нечестивых:","r":[]},{"l":2,"t":"Is in their shame","ru":"В сраме их","r":["PHP 3:19"]},{"l":2,"t":"Ends in destruction","ru":"Кончается погибелью","r":["ISA 5:14"]}]}
