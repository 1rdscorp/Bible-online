{"id":"laver-of-brass","en":"Laver of Brass","ru":"Медный умывальник","lines":[{"l":1,"t":"Moses was commanded to make","ru":"Моисею повелено сделать его","r":["EXO 30:18"]},{"l":1,"t":"Wisdom given to Bezaleel to make","ru":"Веселеилу дана мудрость сделать его","r":["EXO 31:2","EXO 31:9"]},{"l":1,"t":"Made of brazen mirrors of the women","ru":"Сделан из медных зеркал женщин","r":["EXO 38:8"]},{"l":1,"t":"Was placed in the court between the altar and the tabernacle","ru":"Поставлен во дворе между жертвенником и скинией","r":["EXO 30:18","EXO 40:7","EXO 40:30"]},{"l":1,"t":"Was anointed with holy oil","ru":"Помазан святым елеем","r":["EXO 40:11","LEV 8:11"]},{"l":1,"t":"The priests washed in","ru":"Священники омывались из него:","r":[]},{"l":2,"t":"Before consecration","ru":"Перед посвящением","r":["EXO 40:12"]},{"l":2,"t":"Before entering the tabernacle","ru":"Перед входом в скинию","r":["EXO 30:19","EXO 30:20"]},{"l":2,"t":"Before approaching the altar","ru":"Перед приступлением к жертвеннику","r":["EXO 30:20"]},{"l":1,"t":"One made by Solomon for the temple","ru":"Соломон сделал умывальник для храма","r":["1KI 7:23-26","2KI 25:13"]},{"l":1,"t":"Called the Brazen sea","ru":"Назван медным морем","r":["2KI 25:13","JER 52:17"]},{"l":1,"t":"Illustrative of","ru":"Образ:","r":[]},{"l":2,"t":"Christ the fountain for sin","ru":"Христа — источника для омытия греха","r":["ZEC 13:1","REV 1:5"]},{"l":2,"t":"Regeneration","ru":"Возрождения","r":["TIT 3:5","EPH 5:26"]}]}
