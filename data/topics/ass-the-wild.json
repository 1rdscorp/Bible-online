{"id":"ass-the-wild","en":"Ass, the Wild","ru":"Дикий осёл","lines":[{"l":1,"t":"Inhabits wild and solitary places","ru":"Обитает в диких и пустынных местах","r":["JOB 39:6","ISA 32:14","DAN 5:21"]},{"l":1,"t":"Ranges the mountains for food","ru":"Ищет пищи по горам","r":["JOB 39:8"]},{"l":1,"t":"Brays when hungry","ru":"Ревёт, когда голоден","r":["JOB 6:5"]},{"l":1,"t":"Suffers in time of scarcity","ru":"Страдает во время скудости","r":["JER 14:6"]},{"l":1,"t":"Described as","ru":"Описывается как:","r":[]},{"l":2,"t":"Fond of liberty","ru":"Любящий свободу","r":["JOB 39:5"]},{"l":2,"t":"Intractable","ru":"Неукротимый","r":["JOB 11:12"]},{"l":2,"t":"Unsocial","ru":"Нелюдимый","r":["HOS 8:9"]},{"l":1,"t":"Despises his pursuers","ru":"Посмевается над преследующими его","r":["JOB 39:7"]},{"l":1,"t":"Supported by God","ru":"Питается от Бога","r":["PSA 104:10","PSA 104:11"]},{"l":1,"t":"Illustrative of","ru":"Образ:","r":[]},{"l":2,"t":"Intractableness of natural man","ru":"Неукротимости природного человека","r":["JOB 11:12"]},{"l":2,"t":"The wicked in their pursuit of sin","ru":"Нечестивых в их погоне за грехом","r":["JOB 24:5"]},{"l":2,"t":"Israel in their love of idols","ru":"Израиля в его любви к идолам","r":["JER 2:23","JER 2:24"]},{"l":2,"t":"The Assyrian power","ru":"Ассирийской державы","r":["HOS 8:9"]},{"l":2,"t":"The Ishmaelites (Hebrew)","ru":"Измаильтян (евр.)","r":["GEN 16:12"]}]}
