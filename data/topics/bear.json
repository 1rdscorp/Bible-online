{"id":"bear","en":"Bear","ru":"Медведь","lines":[{"l":1,"t":"Inhabits woods","ru":"Обитает в лесах","r":["2KI 2:24"]},{"l":1,"t":"Described as","ru":"Описывается как:","r":[]},{"l":2,"t":"Voracious","ru":"Прожорливый","r":["DAN 7:5"]},{"l":2,"t":"Cunning","ru":"Хитрый","r":["LAM 3:10"]},{"l":2,"t":"Cruel","ru":"Жестокий","r":["AMO 5:19"]},{"l":1,"t":"Often attacks men","ru":"Часто нападает на людей","r":["2KI 2:24","AMO 5:19"]},{"l":1,"t":"Attacks the flock in the presence of the shepherd","ru":"Нападает на стадо при пастухе","r":["1SA 17:34"]},{"l":1,"t":"Particularly fierce when deprived of its young","ru":"Особенно свиреп, когда лишён детёнышей","r":["2SA 17:8","PRO 17:12"]},{"l":1,"t":"Growls when annoyed","ru":"Ревёт, когда раздражён","r":["ISA 59:11"]},{"l":1,"t":"Miraculously killed by David","ru":"Чудесно убит Давидом","r":["1SA 17:36","1SA 17:37"]},{"l":1,"t":"Illustrative of","ru":"Образ:","r":[]},{"l":2,"t":"God in his judgments","ru":"Бога в Его судах","r":["LAM 3:10","HOS 13:8"]},{"l":2,"t":"The natural man","ru":"Природного человека","r":["ISA 11:7"]},{"l":2,"t":"Wicked rulers","ru":"Нечестивых правителей","r":["PRO 28:15"]},{"l":2,"t":"The kingdom of the Medes","ru":"Мидийского царства","r":["DAN 7:5"]},{"l":2,"t":"The kingdom of Antichrist","ru":"Царства антихриста","r":["REV 13:2"]}]}
