{"id":"pilgrims-and-strangers","en":"Pilgrims and Strangers","ru":"Странники и пришельцы","lines":[{"l":1,"t":"Described","ru":"Описываются","r":["JHN 17:16"]},{"l":1,"t":"Saints are called to be","ru":"Святые призваны быть ими","r":["GEN 12:1","ACT 7:3","LUK 14:26","LUK 14:27","LUK 14:33"]},{"l":1,"t":"All saints are","ru":"Все святые — странники и пришельцы","r":["PSA 39:12","1PE 1:1"]},{"l":1,"t":"Saints confess themselves","ru":"Святые исповедуют себя странниками","r":["1CH 29:15","PSA 39:12","PSA 119:19","HEB 11:13"]},{"l":1,"t":"As saints they","ru":"Святые как странники:","r":[]},{"l":2,"t":"Have the example of Christ","ru":"Имеют пример Христа","r":["LUK 9:58"]},{"l":2,"t":"Are strengthened by God","ru":"Укрепляются Богом","r":["DEU 33:25","PSA 84:6","PSA 84:7"]},{"l":2,"t":"Are actuated by faith","ru":"Движимы верой","r":["HEB 11:9"]},{"l":2,"t":"Have their faces toward Zion","ru":"Обращены лицом к Сиону","r":["JER 50:5"]},{"l":2,"t":"Keep the promised in view","ru":"Видят обетования издали","r":["HEB 11:13"]},{"l":2,"t":"Forsake all for Christ","ru":"Оставляют всё ради Христа","r":["MAT 19:27"]},{"l":2,"t":"Look for a heavenly country","ru":"Ищут небесного отечества","r":["HEB 11:16"]},{"l":2,"t":"Look for a heavenly city","ru":"Ожидают небесного града","r":["HEB 11:10"]},{"l":2,"t":"Pass their sojourning in fear","ru":"Проводят время странствования в страхе","r":["1PE 1:17"]},{"l":2,"t":"Rejoice in the statutes of God","ru":"Радуются уставам Божиим","r":["PSA 119:54"]},{"l":2,"t":"Pray for direction","ru":"Молят о руководстве","r":["PSA 43:3","JER 50:5"]},{"l":2,"t":"Have a heavenly conversation","ru":"Имеют жительство на небесах","r":["PHP 3:20"]},{"l":2,"t":"Hate worldly fellowship","ru":"Ненавидят мирское общение","r":["PSA 120:5","PSA 120:6"]},{"l":2,"t":"Are not mindful of this world","ru":"Не думают об этом мире","r":["HEB 11:15"]},{"l":2,"t":"Are not at home in this world","ru":"Не у себя дома в этом мире","r":["HEB 11:9"]},{"l":2,"t":"Shine as lights in the world","ru":"Сияют, как светила в мире","r":["PHP 2:15"]},{"l":2,"t":"Invite others to go with them","ru":"Приглашают других идти с ними","r":["NUM 10:29"]},{"l":2,"t":"Are exposed to persecution","ru":"Подвергаются гонениям","r":["PSA 120:5-7","JHN 17:14"]},{"l":2,"t":"Should abstain from fleshly lusts","ru":"Должны удаляться от плотских похотей","r":["1PE 2:11"]},{"l":2,"t":"Should have their treasure in heaven","ru":"Должны иметь сокровище на небе","r":["MAT 6:19","LUK 12:33","COL 3:1","COL 3:2"]},{"l":2,"t":"Should not be over anxious about worldly things","ru":"Не должны чрезмерно заботиться о мирском","r":["MAT 6:25"]},{"l":2,"t":"Long for their pilgrimage to end","ru":"Жаждут окончания своего странствования","r":["PSA 55:6","2CO 5:1-8"]},{"l":2,"t":"Die in faith","ru":"Умирают в вере","r":["HEB 11:13"]},{"l":2,"t":"The world is not worthy of","ru":"Мир не достоин их","r":["HEB 11:38"]},{"l":1,"t":"God is not ashamed to be called their God","ru":"Бог не стыдится называться их Богом","r":["HEB 11:16"]},{"l":1,"t":"Typified","ru":"Прообразы:","r":[]},{"l":2,"t":"Israel","ru":"Израиль","r":["EXO 6:4","EXO 12:11"]},{"l":1,"t":"Exemplified","ru":"Примеры:","r":[]},{"l":2,"t":"Abraham","ru":"Авраам","r":["GEN 23:4","ACT 7:4","ACT 7:5"]},{"l":2,"t":"Jacob","ru":"Иаков","r":["GEN 47:9"]},{"l":2,"t":"Saints of old","ru":"Святые древности","r":["1CH 29:15","HEB 11:13","HEB 11:38"]},{"l":2,"t":"David","ru":"Давид","r":["PSA 39:12"]},{"l":2,"t":"The Apostles","ru":"Апостолы","r":["MAT 19:27"]}]}
