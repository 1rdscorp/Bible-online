{"id":"trespass-offering","en":"Trespass Offering","ru":"Жертва повинности","lines":[{"l":1,"t":"Esteemed as a sin offering, and frequently so called","r":["LEV 5:6","LEV 5:9"]},{"l":1,"t":"To be offered","r":[]},{"l":2,"t":"For concealing knowledge of a crime","r":["LEV 5:1"]},{"l":2,"t":"For involuntarily touching unclean things","r":["LEV 5:2","LEV 5:3"]},{"l":2,"t":"For rash swearing","r":["LEV 5:4"]},{"l":2,"t":"For sins of ignorance in holy things","r":["LEV 5:15"]},{"l":2,"t":"For any sin of ignorance","r":["LEV 5:17"]},{"l":2,"t":"For breach of trust, or fraud","r":["LEV 6:2-5"]},{"l":1,"t":"Was a most holy offering","r":["LEV 14:13"]},{"l":1,"t":"Consisted of","r":[]},{"l":2,"t":"A she lamb or kid","r":["LEV 5:6"]},{"l":2,"t":"A ram without blemish","r":["LEV 5:15","LEV 6:6"]},{"l":2,"t":"Two turtle doves by those unable to bring a lamb","r":["LEV 5:7-10"]},{"l":2,"t":"A meat offering by the very poor","r":["LEV 5:11-13"]},{"l":1,"t":"Being for minor offences was lessened for the poor, not so the sin offering","r":["LEV 4:1-5:19"]},{"l":1,"t":"Atonement made by","r":["LEV 5:6","LEV 5:10","LEV 5:13","LEV 5:16","LEV 5:18","LEV 6:7","LEV 19:22"]},{"l":1,"t":"Accompanied by confession","r":["LEV 5:5"]},{"l":1,"t":"Generally accompanied by restitution","r":["LEV 5:16","LEV 6:5"]},{"l":1,"t":"To be slain where the sin offering and burnt offering were slain","r":["LEV 14:13","EZK 40:39"]},{"l":1,"t":"Sometimes waved alive before the Lord","r":["LEV 14:12","LEV 14:13"]},{"l":1,"t":"Special occasions of offering","r":[]},{"l":2,"t":"Cleansing of a leper","r":["LEV 14:2","LEV 14:12-14","LEV 14:21","LEV 14:22"]},{"l":2,"t":"Purification of women","r":["LEV 12:6-8"]},{"l":2,"t":"Purification of those with issues","r":["LEV 15:14","LEV 15:15"]},{"l":2,"t":"Purification of Nazarites who had broken their vow","r":["NUM 6:12"]},{"l":2,"t":"For connection with a betrothed bondmaid","r":["LEV 19:20-22"]},{"l":1,"t":"Was the perquisites of the priest","r":["LEV 14:13","EZK 44:29"]},{"l":1,"t":"Illustrative of Christ","r":["ISA 53:10","EZK 46:20"]}]}
