{"id":"salutations","en":"Salutations","ru":"Приветствия","lines":[{"l":1,"t":"Antiquity of","ru":"Древность их","r":["GEN 18:2","GEN 19:1"]},{"l":1,"t":"Were given","ru":"Давались:","r":[]},{"l":2,"t":"By brethren to each other","ru":"Братьями друг другу","r":["1SA 17:22"]},{"l":2,"t":"By inferiors to their superiors","ru":"Низшими высшим","r":["GEN 47:7"]},{"l":2,"t":"By superiors to inferiors","ru":"Высшими низшим","r":["1SA 30:21"]},{"l":2,"t":"By all passers-by","ru":"Всеми прохожими","r":["1SA 10:3","1SA 10:4","PSA 129:8"]},{"l":2,"t":"On entering a house","ru":"При входе в дом","r":["JDG 18:15","MAT 10:12","LUK 1:40","LUK 1:41","LUK 1:44"]},{"l":1,"t":"Often sent through messengers","ru":"Часто передавались через посланных","r":["1SA 25:5","1SA 25:14","2SA 8:10"]},{"l":1,"t":"Often sent by letter","ru":"Часто передавались в письмах","r":["ROM 16:21-23","1CO 16:21","COL 4:18","2TH 3:17"]},{"l":1,"t":"Denied to persons of bad character","ru":"В них отказывали людям дурной жизни","r":["2JN 1:10"]},{"l":1,"t":"Persons in haste excused from giving or receiving","ru":"Спешащие освобождались от необходимости приветствовать и отвечать","r":["2KI 4:29","LUK 10:24"]},{"l":1,"t":"Expressions used as","ru":"Употребляемые выражения:","r":[]},{"l":2,"t":"Peace be with thee","ru":"«Мир тебе»","r":["JDG 19:20"]},{"l":2,"t":"Peace to thee, and peace to thine house, and peace to all that thou hast","ru":"«Мир тебе, мир дому твоему, мир всему твоему»","r":["1SA 25:6"]},{"l":2,"t":"Peace be to this house","ru":"«Мир дому сему»","r":["LUK 10:5"]},{"l":2,"t":"The Lord be with you","ru":"«Господь с вами»","r":["RUT 2:4"]},{"l":2,"t":"The Lord bless thee","ru":"«Да благословит тебя Господь»","r":["RUT 2:4"]},{"l":2,"t":"The blessing of the Lord be upon you, we bless you in the name of the Lord","ru":"«Благословение Господне на вас! благословляем вас именем Господним!»","r":["PSA 129:8"]},{"l":2,"t":"Blessed be thou of the Lord","ru":"«Благословен ты у Господа»","r":["1SA 15:13"]},{"l":2,"t":"God be gracious to thee","ru":"«Бог да будет милостив к тебе»","r":["GEN 43:29"]},{"l":2,"t":"Art thou in health?","ru":"«Здоров ли ты?»","r":["2SA 20:9"]},{"l":2,"t":"Hail","ru":"«Радуйся»","r":["MAT 26:49","LUK 1:28"]},{"l":2,"t":"All hail","ru":"«Радуйтесь»","r":["MAT 28:9"]},{"l":1,"t":"Often perfidious","ru":"Часто вероломны","r":["2SA 20:9","MAT 26:49"]},{"l":1,"t":"Given to Christ in derision","ru":"Воздавались Христу в насмешку","r":["MAT 27:29","MAT 15:18"]},{"l":1,"t":"Often accompanied by","ru":"Часто сопровождались:","r":[]},{"l":2,"t":"Falling on the neck and kissing","ru":"Падением на шею и целованием","r":["GEN 33:4","GEN 45:14","GEN 45:15","LUK 15:20"]},{"l":2,"t":"Laying hold of the bear with the right hand","ru":"Взятием правой рукой за бороду","r":["2SA 20:9"]},{"l":2,"t":"Bowing frequently to the ground","ru":"Многократными поклонами до земли","r":["GEN 33:3"]},{"l":2,"t":"Embracing and kissing the feet","ru":"Объятием и целованием ног","r":["MAT 28:9","LUK 7:38","LUK 7:45"]},{"l":2,"t":"Touching the hem of the garment","ru":"Прикосновением к краю одежды","r":["MAT 14:36"]},{"l":2,"t":"Falling prostrate on the ground","ru":"Падением ниц на землю","r":["EST 8:3","MAT 2:11","LUK 8:41"]},{"l":2,"t":"Kissing the dust","ru":"Лобзанием праха","r":["PSA 72:9","ISA 49:23"]},{"l":1,"t":"The Jews condemned for giving, only to their countrymen","ru":"Иудеи осуждены за то, что приветствовали только своих соотечественников","r":["MAT 5:47"]},{"l":1,"t":"The Pharisees condemned for seeking, in public","ru":"Фарисеи осуждены за то, что искали приветствий в народных собраниях","r":["MAT 23:7","MRK 12:38"]}]}
