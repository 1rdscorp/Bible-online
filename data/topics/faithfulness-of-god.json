{"id":"faithfulness-of-god","en":"Faithfulness of God","ru":"Верность Бога","lines":[{"l":1,"t":"Is part of his character","ru":"Принадлежит к Его свойствам","r":["ISA 49:7","1CO 1:9","1TH 5:24"]},{"l":1,"t":"Declared to be","ru":"Описывается как:","r":[]},{"l":2,"t":"Great","ru":"Великая","r":["LAM 3:23"]},{"l":2,"t":"Established","ru":"Утверждённая","r":["PSA 89:2"]},{"l":2,"t":"Incomparable","ru":"Несравненная","r":["PSA 89:8"]},{"l":2,"t":"Unfailing","ru":"Неизменная","r":["PSA 89:33","2TI 2:13"]},{"l":2,"t":"Infinite","ru":"Безмерная","r":["PSA 36:5"]},{"l":2,"t":"Everlasting","ru":"Вечная","r":["PSA 119:90","PSA 146:6"]},{"l":1,"t":"Should be pleaded in prayer","ru":"На неё следует ссылаться в молитве","r":["PSA 143:1"]},{"l":1,"t":"Should be proclaimed","ru":"Её следует возвещать","r":["PSA 40:10","PSA 89:1"]},{"l":1,"t":"Manifested","ru":"Проявляется:","r":[]},{"l":2,"t":"In his counsels","ru":"В Его определениях","r":["ISA 25:1"]},{"l":2,"t":"In afflicting his saints","ru":"В наказании Его святых","r":["PSA 119:75"]},{"l":2,"t":"In fulfilling his promises","ru":"В исполнении Его обетований","r":["1KI 8:20","PSA 132:11","MIC 7:20","HEB 10:23"]},{"l":2,"t":"In keeping his covenant","ru":"В соблюдении Его завета","r":["DEU 7:9","PSA 111:5"]},{"l":2,"t":"In executing his judgments","ru":"В совершении Его судов","r":["JER 23:20","JER 51:29"]},{"l":2,"t":"In forgiving sins","ru":"В прощении грехов","r":["1JN 1:9"]},{"l":2,"t":"To his saints","ru":"По отношению к Его святым","r":["PSA 89:24","2TH 3:3"]},{"l":2,"t":"Saints encouraged to depend on","ru":"Святые призваны уповать на неё","r":["1PE 4:19"]},{"l":2,"t":"Should be magnified","ru":"Её следует превозносить","r":["PSA 89:5","PSA 92:2"]}]}
