{"id":"apostles","en":"Apostles","ru":"Апостолы","lines":[{"l":1,"t":"Christ pre-eminently called \"The Apostle\"","ru":"Христос по преимуществу называется Посланником","r":["HEB 3:1"]},{"l":1,"t":"Ordained by Christ","ru":"Поставлены Христом","r":["MRK 3:14","JHN 15:16"]},{"l":1,"t":"Received their title from Christ","ru":"Получили своё наименование от Христа","r":["LUK 6:13"]},{"l":1,"t":"Called by","ru":"Призваны:","r":[]},{"l":2,"t":"God","ru":"Богом","r":["1CO 1:1","1CO 12:28","GAL 1:1","GAL 1:15","GAL 1:16"]},{"l":2,"t":"Christ","ru":"Христом","r":["MAT 10:1","MRK 3:13","ACT 20:24","ROM 1:5"]},{"l":2,"t":"The Holy Spirit","ru":"Святым Духом","r":["ACT 20:24","ROM 1:5"]},{"l":1,"t":"Were unlearned men","ru":"Были люди некнижные","r":["ACT 4:13"]},{"l":1,"t":"Selected from obscure stations","ru":"Избраны из незнатных людей","r":["MAT 4:18"]},{"l":1,"t":"Sent first to the house of Israel","ru":"Посланы сначала к дому Израилеву","r":["MAT 10:5","MAT 10:6","LUK 24:47","ACT 13:46"]},{"l":1,"t":"Sent to preach the gospel to all nations","ru":"Посланы проповедовать Евангелие всем народам","r":["MAT 28:19","MAT 28:20","MRK 16:15","2TI 1:11"]},{"l":1,"t":"Christ always present with","ru":"Христос всегда с ними","r":["MAT 28:20"]},{"l":1,"t":"Warned against a timid profession of Christ","ru":"Предостережены от робкого исповедания Христа","r":["MAT 10:27-33"]},{"l":1,"t":"The Holy Spirit given to","ru":"Им дан Святой Дух","r":["JHN 20:22","ACT 2:1-4","ACT 9:17"]},{"l":1,"t":"Guided by the Spirit into all truth","ru":"Наставлены Духом на всякую истину","r":["JHN 14:26","JHN 15:26","JHN 16:13"]},{"l":1,"t":"Instructed by the Spirit to answer adversaries","ru":"Научены Духом отвечать противникам","r":["MAT 10:19","MAT 10:20","LUK 12:11","LUK 12:12"]},{"l":1,"t":"Specially devoted to the office of the ministry","ru":"Особо посвящены служению","r":["ACT 6:4","ACT 20:27"]},{"l":1,"t":"Humility urged upon","ru":"Им заповедано смирение","r":["MAT 20:26","MAT 20:27","MRK 9:33-37",