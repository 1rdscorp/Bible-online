{"id":"truth-of-god","en":"Truth of God","ru":"Истинность Божия","lines":[{"l":1,"t":"Is one of his attributes","ru":"Одно из Его свойств","r":["DEU 32:4","ISA 65:16"]},{"l":1,"t":"Always goes before his face","ru":"Всегда предходит пред лицем Его","r":["PSA 89:14"]},{"l":1,"t":"He keeps, for ever","ru":"Он вечно хранит её","r":["PSA 146:6"]},{"l":1,"t":"Described as","ru":"Описывается как:","r":[]},{"l":2,"t":"Great","ru":"Великая","r":["PSA 57:10"]},{"l":2,"t":"Plenteous","ru":"Обильная","r":["PSA 86:15"]},{"l":2,"t":"Abundant","ru":"Преизобильная","r":["EXO 34:6"]},{"l":2,"t":"Inviolable","ru":"Нерушимая","r":["NUM 23:19","TIT 1:2"]},{"l":2,"t":"Reaching to the clouds","ru":"Достигающая до облаков","r":["PSA 57:10"]},{"l":2,"t":"Enduring to all generations","ru":"Пребывающая в род и род","r":["PSA 100:5"]},{"l":1,"t":"United with mercy in redemption","ru":"Соединена с милостью в искуплении","r":["PSA 85:10"]},{"l":1,"t":"Exhibited in his","ru":"Проявляется в Его:","r":[]},{"l":2,"t":"Counsels of old","ru":"Древних определениях","r":["ISA 25:1"]},{"l":2,"t":"Ways","ru":"Путях","r":["REV 15:3"]},{"l":2,"t":"Works","ru":"Делах","r":["PSA 33:4","PSA 11:7","DAN 4:37"]},{"l":2,"t":"Judicial statutes","ru":"Судебных постановлениях","r":["PSA 19:9"]},{"l":2,"t":"Administration of justice","ru":"Правосудии","r":["PSA 96:13"]},{"l":2,"t":"Word","ru":"Слове","r":["PSA 119:160","JHN 17:17"]},{"l":2,"t":"Fulfilment of promises in Christ","ru":"Исполнении обетований во Христе","r":["2CO 1:20"]},{"l":2,"t":"Fulfilment of his covenant","ru":"Исполнении Своего завета","r":["MIC 7:20"]},{"l":2,"t":"Dealings with saints","ru":"Обращении со святыми","r":["PSA 25:10"]},{"l":2,"t":"Deliverance of saints","ru":"Избавлении святых","r":["PSA 57:3"]},{"l":2,"t":"Punishment of the wicked","ru":"Наказании нечестивых","r":["REV 16:7"]},{"l":1,"t":"Remembered toward saints","ru":"Бог помнит её к святым","r":["PSA 98:3"]},{"l":1,"t":"Is a shield and buckler to saints","ru":"Щит и ограждение для святых","r":["PSA 9:14"]},{"l":1,"t":"We should","ru":"Мы должны:","r":[]},{"l":2,"t":"Confide in","ru":"Уповать на неё","r":["PSA 31:5","TIT 1:2"]},{"l":2,"t":"Plead, in prayer","ru":"Ссылаться на неё в молитве","r":["PSA 89:49"]},{"l":2,"t":"Pray for its manifestation to ourselves","ru":"Молиться, чтобы она явилась нам","r":["2CH 6:17"]},{"l":2,"t":"Pray for its exhibition to others","ru":"Молиться, чтобы она явилась другим","r":["2SA 2:6"]},{"l":2,"t":"Make known to others","ru":"Возвещать её другим","r":["ISA 38:19"]},{"l":2,"t":"Magnify","ru":"Прославлять её","r":["PSA 71:22","PSA 138:2"]},{"l":1,"t":"Is denied by","ru":"Её отрицают:","r":[]},{"l":2,"t":"The devil","ru":"Диавол","r":["GEN 3:4","GEN 3:5"]},{"l":2,"t":"The self-righteous","ru":"Самоправедные","r":["1JN 1:10"]},{"l":2,"t":"Unbelievers","ru":"Неверующие","r":["1JN 5:10"]},{"l":1,"t":"Exemplified towards","ru":"Явлена:","r":[]},{"l":2,"t":"Abraham","ru":"Аврааму","r":["GEN 24:27"]},{"l":2,"t":"Jacob","ru":"Иакову","r":["GEN 32:10"]},{"l":2,"t":"Israel","ru":"Израилю","r":["PSA 98:3"]}]}
