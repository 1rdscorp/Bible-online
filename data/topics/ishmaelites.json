{"id":"ishmaelites","en":"Ishmaelites","ru":"Измаильтяне","lines":[{"l":1,"t":"Descended from Abraham’s son, Ishmael","ru":"Произошли от сына Авраама Измаила","r":["GEN 16:15","GEN 16:16","1CH 1:28"]},{"l":1,"t":"Divided into twelve tribes","ru":"Делились на двенадцать колен","r":["GEN 25:16"]},{"l":1,"t":"Heads of tribes","ru":"Князья колен","r":["GEN 25:13-15","1CH 1:29-31"]},{"l":1,"t":"Called","ru":"Назывались:","r":[]},{"l":2,"t":"Hagarites","ru":"Агаряне","r":["1CH 5:10"]},{"l":2,"t":"Hagarenes","ru":"Агарийцы","r":["PSA 83:6"]},{"l":2,"t":"Arabians","ru":"Аравитяне","r":["ISA 13:20"]},{"l":1,"t":"Original possessions of","ru":"Их первоначальные владения","r":["GEN 25:18"]},{"l":1,"t":"Governed by kings","ru":"Управлялись царями","r":["JER 25:24"]},{"l":1,"t":"Dwelt in tents","ru":"Жили в шатрах","r":["ISA 13:20"]},{"l":1,"t":"Rich in cattle","ru":"Богаты скотом","r":["1CH 5:21"]},{"l":1,"t":"Wore ornaments of gold","ru":"Носили золотые украшения","r":["JDG 8:24"]},{"l":1,"t":"Were the merchants of the east","ru":"Были купцами Востока","r":["GEN 37:25","EZK 27:20","EZK 27:21"]},{"l":1,"t":"Travelled in large companies or caravans","ru":"Путешествовали большими караванами","r":["GEN 37:25","JOB 6:19"]},{"l":1,"t":"Waylaid and plundered travellers","ru":"Подстерегали и грабили путников","r":["JER 3:2"]},{"l":1,"t":"Often confederate against Israel","ru":"Часто вступали в союз против Израиля","r":["PSA 83:6"]},{"l":1,"t":"Overcome by","ru":"Побеждены:","r":[]},{"l":2,"t":"Gideon","ru":"Гедеоном","r":["JDG 8:10-24"]},{"l":2,"t":"Reubenites and Gadites","ru":"Рувимлянами и гадитянами","r":["1CH 5:10","1CH 5:18-20"]},{"l":2,"t":"Uzziah","ru":"Озией","r":["2CH 26:7"]},{"l":1,"t":"Sent presents to Solomon","ru":"Посылали дары Соломону","r":["1KI 10:15","2CH 9:14"]},{"l":1,"t":"Sent flocks to Jehoshaphat","ru":"Пригоняли скот Иосафату","r":["2CH 17:11"]},{"l":1,"t":"Predictions respecting","ru":"Предсказания о них:","r":[]},{"l":2,"t":"To be numerous","ru":"Будут многочисленны","r":["GEN 16:10","GEN 17:20"]},{"l":2,"t":"To be wild and savage","ru":"Будут дики и свирепы","r":["GEN 16:12"]},{"l":2,"t":"To be warlike and predatory","ru":"Будут воинственны и хищны","r":["GEN 16:12"]},{"l":2,"t":"To be divided into twelve tribes","ru":"Разделятся на двенадцать колен","r":["GEN 17:20"]},{"l":2,"t":"To continue independent","ru":"Сохранят независимость","r":["GEN 16:12"]},{"l":2,"t":"To be a great nation","ru":"Станут великим народом","r":["GEN 21:13","GEN 21:18"]},{"l":2,"t":"To be judged with the nations","ru":"Будут судимы вместе с народами","r":["JER 25:23-25"]},{"l":2,"t":"Their glory, & c to be diminished","ru":"Их слава и т. д. умалится","r":["ISA 21:13-17"]},{"l":2,"t":"Their submission to Christ","ru":"Покорятся Христу","r":["PSA 72:10","PSA 72:15"]},{"l":1,"t":"Probably preached to by Paul","ru":"Павел, вероятно, проповедовал им","r":["GAL 1:17"]}]}
