2"]},{"l":2,"t":"Keep, in remembrance","ru":"Хранят его в памяти","r":["PSA 119:16"]},{"l":2,"t":"Grieve when men disobey","ru":"Скорбят, когда люди не исполняют его","r":["PSA 119:158"]},{"l":2,"t":"Hide, in their hearts","ru":"Сокрывают его в сердце","r":["PSA 119:11"]},{"l":2,"t":"Hope in","ru":"Уповают на него","r":["PSA 119:74","PSA 119:81","PSA 119:147"]},{"l":2,"t":"Meditate in","ru":"Размышляют о нём","r":["PSA 1:2","PSA 119:99","PSA 119:148"]},{"l":2,"t":"Rejoice in","ru":"Радуются о нём","r":["PSA 119:162","JER 15:16"]},{"l":2,"t":"Trust in","ru":"Надеются на него","r":["PSA 119:42"]},{"l":2,"t":"Obey","ru":"Исполняют его","r":["PSA 119:67","LUK 8:21","JHN 17:6"]},{"l":2,"t":"Speak of","ru":"Говорят о нём","r":["PSA 119:172"]},{"l":2,"t":"Esteem, as a light","ru":"Почитают его светом","r":["PSA 119:105"]},{"l":2,"t":"Pray to be taught","ru":"Молятся о научении ему","r":["PSA 119:12","PSA 119:13","PSA 119:33","PSA 119:66"]},{"l":2,"t":"Pray to be conformed to","ru":"Молятся о том, чтобы жить по нему","r":["PSA 119:133"]},{"l":2,"t":"Plead the promises of, in prayer","ru":"Ссылаются в молитве на его обетования","r":["PSA 119:25","PSA 119:28","PSA 119:41","PSA 119:76","PSA 119:169"]},{"l":1,"t":"They who search, are truly noble","ru":"Исследующие его поистине благородны","r":["ACT 17:11"]},{"l":1,"t":"Blessedness of hearing and obeying","ru":"Блаженство слушающих и исполняющих его","r":["LUK 11:28","JAS 1:25"]},{"l":1,"t":"Let them dwell richly in you","ru":"Да вселяется оно в вас обильно","r":["COL 3:16"]},{"l":1,"t":"The wicked","ru":"Нечестивые:","r":[]},{"l":2,"t":"Corrupt","ru":"Повреждают его","r":["2CO 2:17"]},{"l":2,"t":"Make, of none effect through their traditions","ru":"Устраняют его своими преданиями","r":["MRK 7:9-13"]},{"l":2,"t":"Reject","ru":"Отвергают его","r":["JER 8:9"]},{"l":2,"t":"Stumble at","ru":"Претыкаются о него","r":["1PE 2:8"]},{"l":2,"t":"Obey not","ru":"Не покоряются ему","r":["PSA 119:158"]},{"l":2,"t":"Frequently wrest, to their own destruction","ru":"Нередко превращают его к собственной погибели","r":["2PE 3:16"]},{"l":1,"t":"Denunciations against those who add to, or take from","ru":"Осуждение прибавляющих к нему или отнимающих от него","r":["REV 22:18","REV 22:19"]},{"l":1,"t":"Destruction of, punished","ru":"Уничтожение его наказано","r":["JER 36:29-31"]}]}
