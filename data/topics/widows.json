{"id":"widows","en":"Widows","ru":"Вдовы","lines":[{"l":1,"t":"Character of true","ru":"Черты истинной вдовы","r":["LUK 2:37","1TI 5:5","1TI 5:10"]},{"l":1,"t":"God","ru":"Бог:","r":[]},{"l":2,"t":"Surely hears the cry of","ru":"Непременно услышит вопль вдов","r":["EXO 22:23"]},{"l":2,"t":"Judges for","ru":"Даёт суд вдове","r":["DEU 10:18","PSA 68:5"]},{"l":2,"t":"Relieves","ru":"Поддерживает вдов","r":["PSA 146:9"]},{"l":2,"t":"Establishes the border of","ru":"Утверждает межу вдовы","r":["PRO 15:25"]},{"l":2,"t":"Will witness against oppressors of","ru":"Будет свидетелем против притеснителей вдов","r":["MAL 3:5"]},{"l":1,"t":"Exhorted to trust in God","ru":"Призываются уповать на Бога","r":["JER 49:11"]},{"l":1,"t":"Should not be","ru":"Нельзя:","r":[]},{"l":2,"t":"Afflicted","ru":"Притеснять их","r":["EXO 22:22"]},{"l":2,"t":"Oppressed","ru":"Угнетать их","r":["JER 7:6","ZEC 7:10"]},{"l":2,"t":"Treated with violence","ru":"Обижать их насилием","r":["JER 22:3"]},{"l":2,"t":"Deprived of raiment in pledge","ru":"Брать у них одежду в залог","r":["DEU 24:17"]},{"l":1,"t":"Should be","ru":"Должно:","r":[]},{"l":2,"t":"Pleaded for","ru":"Заступаться за них","r":["ISA 1:17"]},{"l":2,"t":"Honoured, if widows indeed","ru":"Почитать их, если они истинные вдовы","r":["1TI 5:3"]},{"l":2,"t":"Relieved by their friends","ru":"Заботиться о них их родным","r":["1TI 5:4","1TI 5:16"]},{"l":2,"t":"Relieved by the Church","ru":"Заботиться о них Церкви","r":["ACT 6:1","1TI 5:9"]},{"l":2,"t":"Visited in affliction","ru":"Посещать их в скорби","r":["JAS 1:27"]},{"l":2,"t":"Allowed to share in our blessings","ru":"Давать им долю в наших благах","r":["DEU 14:29","DEU 16:11","DEU 16:14","DEU 24:19-21"]},{"l":1,"t":"Though poor, may be liberal","ru":"Могут быть щедрыми, даже будучи бедными","r":["MRK 12:42","MRK 12:43"]},{"l":1,"t":"When young, exposed to may temptations","ru":"Молодые подвержены многим искушениям","r":["1TI 5:11-14"]},{"l":1,"t":"Saints","ru":"Святые:","r":[]},{"l":2,"t":"Relieve","ru":"Помогают вдовам","r":["ACT 9:39"]},{"l":2,"t":"Cause joy to","ru":"Радуют сердце вдовы","r":["JOB 29:13"]},{"l":2,"t":"Disappoint not","ru":"Не томят очей вдовы","r":["JOB 31:16"]},{"l":1,"t":"The wicked","ru":"Нечестивые:","r":[]},{"l":2,"t":"Do no good to","ru":"Не делают добра вдове","r":["JOB 24:21"]},{"l":2,"t":"Send, away empty","ru":"Отпускают вдов ни с чем","r":["JOB 22:9"]},{"l":2,"t":"Take pledges from","ru":"Берут у вдовы в залог","r":["JOB 24:3"]},{"l":2,"t":"Reject the cause of","ru":"Не принимают к себе дела вдовы","r":["ISA 1:23"]},{"l":2,"t":"Vex","ru":"Обижают вдов","r":["EZK 22:7"]},{"l":2,"t":"Make a prey of","ru":"Делают вдов своей добычей","r":["ISA 10:2","MAT 23:14"]},{"l":2,"t":"Slay","ru":"Убивают вдов","r":["PSA 94:6"]},{"l":1,"t":"Curse for perverting judgment of","ru":"Проклят, кто превратно судит вдову","r":["DEU 27:19"]},{"l":1,"t":"Woe to those who oppress","ru":"Горе притесняющим вдов","r":["ISA 10:1","ISA 10:2"]},{"l":1,"t":"Blessings on those who relieve","ru":"Благословения помогающим вдовам","r":["DEU 14:29"]},{"l":1,"t":"A type of Zion in affliction","ru":"Образ Сиона в скорби","r":["LAM 5:3"]},{"l":1,"t":"Were released from all obligation to former husbands","ru":"Освобождались от всяких обязательств перед прежними мужьями","r":["ROM 7:3"]},{"l":1,"t":"Were clothed in mourning after the decease of husbands","ru":"После смерти мужей носили траурную одежду","r":["GEN 38:14","GEN 38:19","2SA 14:2","2SA 14:5"]},{"l":1,"t":"Reproach connected with","ru":"С вдовством связывался позор","r":["ISA 54:4"]},{"l":1,"t":"Increase of, threatened as a punishment","ru":"Умножение вдов возвещено как наказание","r":["EXO 22:24","JER 15:8","JER 18:21"]},{"l":1,"t":"Laws respecting","ru":"Законы о вдовах:","r":[]},{"l":2,"t":"Not to be oppressed","ru":"Не притеснять их","r":["EXO 22:22","DEU 27:19"]},{"l":2,"t":"Raiment of, not to be taken in pledge by creditors","ru":"Не брать у них одежды в залог","r":["DEU 24:17"]},{"l":2,"t":"Bound to perform their vows","ru":"Должны исполнять свои обеты","r":["NUM 30:9"]},{"l":2,"t":"Not to intermarry with priests","ru":"Не выходить замуж за священников","r":["LEV 21:14"]},{"l":2,"t":"To be allowed to glean in fields and vineyards","ru":"Им позволено подбирать остатки на полях и в виноградниках","r":["DEU 24:19"]},{"l":2,"t":"To have a share of the triennial tithe","ru":"Им полагается доля десятины третьего года","r":["DEU 14:28","DEU 14:29","DEU 26:12","DEU 26:13"]},{"l":2,"t":"To share in public rejoicings","ru":"Участвовать в народных празднествах","r":["DEU 16:11","DEU 16:14"]},{"l":2,"t":"When daughters of priests and childless to partake of the holy things","ru":"Бездетные дочери священников могли есть от святынь","r":["LEV 22:13"]},{"l":2,"t":"When left childless, to be married by their husband’s nearest of kin","ru":"Бездетную брал в жёны ближайший родственник мужа","r":["DEU 25:5","DEU 25:6","RUT 3:10-13","RUT 4:4","RUT 4:5","MAT 22:24-26"]},{"l":1,"t":"Allowed to marry again","ru":"Могли вновь выходить замуж","r":["ROM 7:3"]},{"l":1,"t":"Intermarrying with, of kings considered treason","ru":"Женитьба на вдове царя считалась изменой","r":["1KI 2:21-24"]},{"l":1,"t":"Not to be deplored by, considered a great calamity","ru":"Когда вдовы не оплакивают умерших, это великое бедствие","r":["JOB 27:15","PSA 78:64"]},{"l":1,"t":"Were under the special protection of God","ru":"Находились под особым покровительством Божиим","r":["DEU 10:18","PSA 68:5"]},{"l":1,"t":"Were frequently oppressed and persecuted","ru":"Часто подвергались притеснениям и гонениям","r":["JOB 24:3","EZK 22:7"]},{"l":1,"t":"Specially taken care of by the Church","ru":"Церковь особо заботилась о них","r":["ACT 6:1","1TI 5:9"]},{"l":1,"t":"Often devoted themselves entirely to God’s service","ru":"Часто всецело посвящали себя служению Богу","r":["LUK 2:37","1TI 5:10"]},{"l":1,"t":"Instances of great liberality in","ru":"Примеры великой щедрости вдов","r":["1KI 17:9-15","MRK 12:42","MRK 12:43"]},{"l":1,"t":"Illustrative of","ru":"Образ:","r":[]},{"l":2,"t":"A desolate condition","ru":"Опустошённого состояния","r":["ISA 47:8","ISA 47:9"]},{"l":2,"t":"Zion in captivity","ru":"Сиона в плену","r":["LAM 1:1"]}]}
