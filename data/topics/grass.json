{"id":"grass","en":"Grass","ru":"Трава","lines":[{"l":1,"t":"A green herb","ru":"Зелёное растение","r":["MRK 6:39"]},{"l":1,"t":"Called","ru":"Называется:","r":[]},{"l":2,"t":"Grass of the earth","ru":"Трава земли","r":["REV 9:4"]},{"l":2,"t":"Grass of the field","ru":"Трава полевая","r":["NUM 22:4"]},{"l":1,"t":"Springs out of the earth","ru":"Произрастает из земли","r":["2SA 23:4"]},{"l":1,"t":"God","ru":"Бог:","r":[]},{"l":2,"t":"Originally created","ru":"Изначально сотворил её","r":["GEN 1:11","GEN 1:12"]},{"l":2,"t":"The giver of","ru":"Даёт её","r":["DEU 11:15"]},{"l":2,"t":"Causes to grow","ru":"Возращает её","r":["PSA 104:14","PSA 147:8"]},{"l":2,"t":"Adorns and clothes","ru":"Украшает и одевает её","r":["MAT 6:30"]},{"l":1,"t":"Often grew on the tops of houses","ru":"Часто росла на кровлях домов","r":["PSA 129:6"]},{"l":1,"t":"When young, soft and tender","ru":"Молодая — мягка и нежна","r":["PRO 27:25"]},{"l":1,"t":"Refreshed by rain and dew","ru":"Освежается дождём и росою","r":["DEU 32:2","PRO 19:12"]},{"l":1,"t":"Cattle fed upon","ru":"Служит пищей скоту","r":["JOB 6:5","JER 50:11"]},{"l":1,"t":"Ovens often heated with","ru":"Ею часто топили печи","r":["MAT 6:30"]},{"l":1,"t":"Destroyed by","ru":"Истребляется:","r":[]},{"l":2,"t":"Locusts","ru":"Саранчой","r":["REV 9:4"]},{"l":2,"t":"Hail and lightning","ru":"Градом и молнией","r":["REV 8:7"]},{"l":2,"t":"Drought","ru":"Засухой","r":["1KI 17:1","1KI 18:5"]},{"l":1,"t":"Failure of, a great calamity","ru":"Её оскудение — великое бедствие","r":["ISA 15:5","ISA 15:6"]},{"l":1,"t":"Sufferings of cattle from failure of, described","ru":"Описаны страдания скота от её оскудения","r":["JER 14:5","JER 14:6"]},{"l":1,"t":"Illustrative","ru":"В переносном смысле:","r":[]},{"l":2,"t":"Of shortness and uncertainty of life","ru":"Краткость и непрочность жизни","r":["PSA 90:5","PSA 90:6","PSA 103:15","ISA 40:6","ISA 40:7","1PE 1:24"]},{"l":2,"t":"Of prosperity of the wicked","ru":"Благополучие нечестивых","r":["PSA 92:7