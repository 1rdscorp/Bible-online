{"id":"simplicity","en":"Simplicity","ru":"Простота","lines":[{"l":1,"t":"Is opposed to fleshly wisdom","ru":"Противоположна плотской мудрости","r":["2CO 1:12"]},{"l":1,"t":"Necessity for","ru":"Необходимость простоты","r":["MAT 18:2","MAT 18:3"]},{"l":1,"t":"Should be exhibited","ru":"Должна проявляться:","r":[]},{"l":2,"t":"In preaching the gospel","ru":"В проповеди Евангелия","r":["1TH 2:3-7"]},{"l":2,"t":"In acts of benevolence","ru":"В делах благотворения","r":["ROM 12:8"]},{"l":2,"t":"In all our conduct","ru":"Во всём нашем поведении","r":["2CO 1:12"]},{"l":2,"t":"Concerning our own wisdom","ru":"В отношении собственной мудрости","r":["1CO 3:18"]},{"l":2,"t":"Concerning evil","ru":"В отношении зла","r":["ROM 16:19"]},{"l":2,"t":"Concerning malice","ru":"В отношении злобы","r":["1CO 14:20"]},{"l":1,"t":"Exhortation to","ru":"Призыв к ней","r":["ROM 16:19","1PE 2:2"]},{"l":1,"t":"They who have the grace of","ru":"Имеющие благодать простоты:","r":[]},{"l":2,"t":"Are made wise by God","ru":"Умудряются Богом","r":["MAT 11:25"]},{"l":2,"t":"Are made wise by the word of God","ru":"Умудряются словом Божиим","r":["PSA 19:7","PSA 119:130"]},{"l":2,"t":"Are preserved by God","ru":"Хранимы Богом","r":["PSA 116:6"]},{"l":2,"t":"Made circumspect by instruction","ru":"Становятся осмотрительными через наставление","r":["PRO 1:4"]},{"l":2,"t":"Profit by the correction of others","ru":"Извлекают пользу из наказания других","r":["PRO 19:25","PRO 21:11"]},{"l":1,"t":"Beware of being corrupted from that, which is in Christ","ru":"Беречься, чтобы не уклониться от простоты во Христе","r":["2CO 11:3"]},{"l":1,"t":"Illustrated","ru":"Притчи и образы","r":["MAT 6:22"]},{"l":1,"t":"Exemplified","ru":"Примеры:","r":[]},{"l":2,"t":"David","ru":"Давид","r":["PSA 131:1","PSA 131:2"]},{"l":2,"t":"Jeremiah","ru":"Иеремия","r":["JER 1:6"]},{"l":2,"t":"The Christians","ru":"Христиане","r":["ACT 2:46","ACT 4:32"]},{"l":2,"t":"Paul","ru":"Павел","r":["2CO 1:12"]}]}
