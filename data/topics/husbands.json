{"id":"husbands","en":"Husbands","ru":"Мужья","lines":[{"l":1,"t":"Should have but one wife","r":["GEN 2:24","MRK 10:6-8","1CO 7:2-4"]},{"l":1,"t":"Have authority over their wives","r":["GEN 3:16","1CO 11:3","EPH 5:23"]},{"l":1,"t":"Duty of, to wives","r":[]},{"l":2,"t":"To respect them","r":["1PE 3:7"]},{"l":2,"t":"To love them","r":["EPH 5:25-33","COL 3:19"]},{"l":2,"t":"To regard them as themselves","r":["GEN 2:23","MAT 19:5"]},{"l":2,"t":"To be faithful to them","r":["PRO 5:19","MAL 2:14","MAL 2:15"]},{"l":2,"t":"To dwell with them for life","r":["GEN 2:24","MAT 19:3-9"]},{"l":2,"t":"To comfort them","r":["1SA 1:8"]},{"l":2,"t":"To consult with them","r":["GEN 31:4-7"]},{"l":2,"t":"Not to leave them, though unbelieving","r":["1CO 7:11","1CO 7:12","1CO 7:14","1CO 7:16"]},{"l":1,"t":"Duties of, not to interfere with their duties to Christ","r":["LUK 14:26","MAT 19:29"]},{"l":1,"t":"Good","r":[]},{"l":2,"t":"Isaac","r":["GEN 24:67"]},{"l":2,"t":"Elkanah","r":["1SA 1:4","1SA 1:5"]},{"l":1,"t":"Bad","r":[]},{"l":2,"t":"Solomon","r":["1KI 11:1"]},{"l":2,"t":"Ahasuerus","r":["EST 1:10","EST 1:11"]}]}
