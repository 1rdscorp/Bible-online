{"id":"ploughing","en":"Ploughing","ru":"Пахота","lines":[{"l":1,"t":"The breaking up or tilling of the earth","ru":"Вспахивание, или обработка, земли","r":["JER 4:3","HOS 10:12"]},{"l":1,"t":"Noah the supposed inventor of","ru":"Изобретателем её считается Ной","r":["GEN 5:29"]},{"l":1,"t":"Performed","ru":"Производилась:","r":[]},{"l":2,"t":"By a plough","ru":"Плугом","r":["LUK 9:62"]},{"l":2,"t":"With oxen","ru":"На волах","r":["1SA 14:14","JOB 1:14"]},{"l":2,"t":"During the cold winter season","ru":"В холодную зимнюю пору","r":["PRO 20:4"]},{"l":2,"t":"In long and straight furrows","ru":"Длинными и прямыми бороздами","r":["PSA 129:3"]},{"l":2,"t":"Generally by servants","ru":"Обычно слугами","r":["ISA 61:5","LUK 17:7"]},{"l":2,"t":"Sometimes by the owner of the land himself","ru":"Иногда самим владельцем земли","r":["1KI 19:19"]},{"l":1,"t":"With an ox and an ass yoked together forbidden to the Jews","ru":"Иудеям запрещалось пахать на воле и осле вместе","r":["DEU 22:10"]},{"l":1,"t":"Difficulty of, on rocky ground","ru":"Трудность её на каменистой почве","r":["AMO 6:12"]},{"l":1,"t":"Followed by harrowing and sowing","ru":"За ней следовали боронование и посев","r":["ISA 28:24","ISA 28:25"]},{"l":1,"t":"Illustrative","ru":"В переносном смысле:","r":[]},{"l":2,"t":"Of repentance and reformation","ru":"О покаянии и исправлении","r":["JER 4:3"]},{"l":2,"t":"Of peace and prosperity","ru":"О мире и благоденствии","r":["ISA 2:4","MIC 4:3"]},{"l":2,"t":"Of a severe course of affliction","ru":"О тяжких бедствиях","r":["HOS 10:11"]},{"l":2,"t":"Of a course of sin","ru":"О пути греха","r":["JOB 4:8","HOS 10:13"]},{"l":2,"t":"Of the labour ministers","ru":"О труде служителей","r":["1CO 9:10"]},{"l":2,"t":"(Attention and constancy required in,) of continued devotedness","ru":"(Внимание и постоянство при пахоте) — о неизменной преданности","r":["LUK 9:62"]}]}
