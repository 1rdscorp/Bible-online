{"id":"spear","en":"Spear","ru":"Копьё","lines":[{"l":1,"t":"An offensive weapon","ru":"Наступательное оружие","r":["2SA 23:8","2SA 23:18"]},{"l":1,"t":"First mention of, in Scripture","ru":"Первое упоминание о нём в Писании","r":["JOS 8:18"]},{"l":1,"t":"Parts of mentioned","ru":"Упоминаемые части его:","r":[]},{"l":2,"t":"The staff of wood","ru":"Деревянное древко","r":["1SA 17:7"]},{"l":2,"t":"The head of iron or brass","ru":"Наконечник из железа или меди","r":["1SA 17:7","2SA 21:16"]},{"l":1,"t":"Probably pointed at both ends","ru":"Вероятно, было заострено с обоих концов","r":["2SA 2:23"]},{"l":1,"t":"Called the glittering spear","ru":"Называется сверкающим копьём","r":["JOB 39:23","HAB 3:11"]},{"l":1,"t":"Different kinds of","ru":"Различные виды его:","r":[]},{"l":2,"t":"Lances","ru":"Копья","r":["JER 50:42"]},{"l":2,"t":"Javelins","ru":"Метательные копья","r":["NUM 25:7","1SA 18:10"]},{"l":2,"t":"Darts","ru":"Дротики","r":["2SA 18:14","JOB 41:26","JOB 41:29"]},{"l":1,"t":"Those who used, called spearmen","ru":"Владевшие им назывались копейщиками","r":["PSA 68:30","ACT 23:23"]},{"l":1,"t":"Frequently used by horse soldiers","ru":"Часто употреблялось конницей","r":["NAM 3:3"]},{"l":1,"t":"Furbished before war","ru":"Перед войной вычищалось","r":["JER 46:4"]},{"l":1,"t":"Pruning-hooks made into, before war","ru":"Перед войной из серпов ковали копья","r":["JOL 3:10"]},{"l":1,"t":"Made into pruning-hooks in peace","ru":"В мирное время перековывалось на серпы","r":["ISA 2:4","MIC 4:3"]},{"l":1,"t":"The Israelites","ru":"Израильтяне:","r":[]},{"l":2,"t":"Acquainted with the making of","ru":"Умели изготовлять его","r":["1SA 13:19"]},{"l":2,"t":"Frequently used","ru":"Часто употребляли его","r":["NEH 4:13","NEH 4:16"]},{"l":2,"t":"Ill provided with, in the times of Deborah and Saul","ru":"Были плохо снабжены им во дни Деворы и Саула","r":["JDG 5:8","1SA 13:22"]},{"l":1,"t":"Provided by the kings of Israel in great abundance","ru":"Цари израильские заготовляли его в большом количестве","r":["2CH 11:12","2CH 32:5"]},{"l":1,"t":"Frequently thrown from the hand","ru":"Часто металось рукой","r":["1SA 18:11","1SA 19:10"]},{"l":1,"t":"Often retained in the hand of the person using","ru":"Часто оставалось в руке воина","r":["NUM 25:7","2SA 2:23"]},{"l":1,"t":"Stuck in the ground beside the bolster during sleep","ru":"Во время сна втыкалось в землю у изголовья","r":["1SA 26:7-11"]},{"l":1,"t":"Illustrative of the bitterness of the wicked","ru":"Образ злобы нечестивых","r":["PSA 57:4"]}]}
