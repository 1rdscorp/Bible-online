1,"t":"Judges of","ru":"Судьи:","r":[]},{"l":2,"t":"Called elders","ru":"Назывались старейшинами","r":["DEU 25:7","1SA 16:4"]},{"l":2,"t":"Called magistrates","ru":"Назывались начальниками","r":["LUK 12:58"]},{"l":2,"t":"Rode often on white asses","ru":"Часто ездили на белых ослицах","r":["JDG 5:10"]},{"l":2,"t":"To judge righteously","ru":"Должны судить праведно","r":["LEV 19:15","DEU 1:6"]},{"l":2,"t":"To judge without respect of persons","ru":"Должны судить нелицеприятно","r":["EXO 23:3","EXO 23:6","LEV 19:15","DEU 1:17","PRO 22:22"]},{"l":2,"t":"To investigate every case","ru":"Должны расследовать всякое дело","r":["DEU 19:18"]},{"l":2,"t":"Not to take bribes","ru":"Не должны брать даров","r":["EXO 23:8","DEU 16:19"]},{"l":2,"t":"To judge as for God","ru":"Должны судить как для Господа","r":["2CH 19:6","2CH 19:7","2CH 19:9"]},{"l":2,"t":"To decide according to the law","ru":"Должны решать по закону","r":["EZK 44:24"]},{"l":2,"t":"To promote peace","ru":"Должны содействовать миру","r":["ZEC 8:16"]},{"l":2,"t":"Sat on the judgment-seat while hearing causes","ru":"Сидели на судейском месте, слушая дела","r":["EXO 18:13","JDG 5:10","ISA 28:6","MAT 27:19"]},{"l":2,"t":"Examined the parties","ru":"Допрашивали стороны","r":["ACT 24:8"]},{"l":2,"t":"Conferred together before giving judgment","ru":"Совещались перед вынесением приговора","r":["ACT 5:34-40","ACT 25:12","ACT 26:30","ACT 26:31"]},{"l":2,"t":"Pronounced the judgment of the court","ru":"Объявляли приговор суда","r":["MAT 26:65","MAT 26:66","LUK 23:24","ACT 5:40"]},{"l":1,"t":"Both the accusers and accused required to appear before","ru":"Перед судом обязаны были предстать и обвинители, и обвиняемые","r":["DEU 25:1","ACT 25:16"]},{"l":1,"t":"Causes in, were opened by","ru":"Дело в суде открывали:","r":[]},{"l":2,"t":"The complainant","ru":"Истец","r":["1KI 3:17-21","ACT 16:19-21"]},{"l":2,"t":"An advocate","ru":"Ритор","r":["ACT 24:1"]},{"l":1,"t":"The accused","ru":"Обвиняемые:","r":[]},{"l":2,"t":"Stood befor