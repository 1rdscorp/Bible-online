{"id":"fountains-and-springs","en":"Fountains and Springs","ru":"Источники и родники","lines":[{"l":1,"t":"Created by God","ru":"Сотворены Богом","r":["PSA 74:15","PSA 104:10"]},{"l":1,"t":"God to be praised for","ru":"Бога следует славить за них","r":["REV 14:7"]},{"l":1,"t":"Come from the great deep","ru":"Исходят из великой бездны","r":["GEN 7:11","JOB 38:16"]},{"l":1,"t":"Found in hills and valleys","ru":"Находятся на горах и в долинах","r":["DEU 8:7","PSA 104:10"]},{"l":1,"t":"Send forth each but one kind of water","ru":"Каждый изводит лишь один род воды","r":["JAS 3:11"]},{"l":1,"t":"Afford","ru":"Дают:","r":[]},{"l":2,"t":"Drink to the beasts","ru":"Питьё зверям","r":["PSA 104:11"]},{"l":2,"t":"Refreshment to the birds","ru":"Освежение птицам","r":["PSA 104:12"]},{"l":2,"t":"Fruitfulness to the earth","ru":"Плодородие земле","r":["1KI 18:5","JOL 3:18"]},{"l":1,"t":"Frequented by travellers","ru":"Посещаются путниками","r":["GEN 16:7"]},{"l":1,"t":"Abound in Canaan","ru":"Изобилуют в Ханаане","r":["DEU 8:7","1KI 18:5"]},{"l":1,"t":"Sometimes dried up","ru":"Иногда пересыхают","r":["ISA 58:11"]},{"l":1,"t":"Drying up of, a severe punishment","ru":"Их иссякновение — тяжкое наказание","r":["PSA 107:33","PSA 107:34","HOS 13:15"]},{"l":1,"t":"Constantly flowing","ru":"Непрестанно текущие источники:","r":[]},{"l":2,"t":"Especially esteemed","ru":"Особенно ценились","r":["ISA 58:11"]},{"l":2,"t":"Could not be ceremonially defiled","ru":"Не делались нечистыми по закону","r":["LEV 11:36"]},{"l":1,"t":"Sometimes stopped or turned off to distress enemies","ru":"Иногда их заваливали или отводили, чтобы стеснить врагов","r":["2CH 32:3","2CH 32:4"]},{"l":1,"t":"Mentioned in scripture","ru":"Упоминаются в Писании:","r":[]},{"l":2,"t":"In the way to Shur","ru":"Источник на дороге к Суру","r":["GEN 16:7"]},{"l":2,"t":"Of the waters of Nephtoah","ru":"Источник вод Нефтоах","r":["JOS 15:9"]},{"l":2,"t":"Of Jezreel","ru":"Источник в Изрееле","r":["1SA 29:1"]},{"l":2,"t":"Of Pisgah","ru":"Источники Фасги","r":["DEU 4:49"]},{"l":2,"t":"Upper and nether springs","ru":"Источники верхние и нижние","r":["JOS 15:19","JDG 1:15"]},{"l":1,"t":"Illustrative","ru":"В переносном смысле:","r":[]},{"l":2,"t":"Of God","ru":"Бог","r":["PSA 36:9","JER 2:13","JER 17:13"]},{"l":2,"t":"Of Christ","ru":"Христос","r":["ZEC 13:1"]},{"l":2,"t":"Of the Holy Spirit","ru":"Святой Дух","r":["JHN 7:38","JHN 7:39"]},{"l":2,"t":"Of constant supplies of grace","ru":"Непрестанное подаяние благодати","r":["PSA 87:7"]},{"l":2,"t":"Of eternal life","ru":"Вечная жизнь","r":["JHN 4:14","REV 21:6"]},{"l":2,"t":"Of the means of grace","ru":"Средства благодати","r":["ISA 41:18","JOL 3:18"]},{"l":2,"t":"Of a good wife","ru":"Добрая жена","r":["PRO 5:18"]},{"l":2,"t":"Of a numerous posterity","ru":"Многочисленное потомство","r":["DEU 33:28"]},{"l":2,"t":"Of spiritual wisdom","ru":"Духовная мудрость","r":["PRO 16:22","PRO 18:4"]},{"l":2,"t":"Of the law of the wise","ru":"Учение мудрого","r":["PRO 13:14"]},{"l":2,"t":"Of godly fear","ru":"Страх Божий","r":["PRO 14:27"]},{"l":2,"t":"(Sealed up,) of the church","ru":"(Запечатанный) — Церковь","r":["SNG 4:12"]},{"l":2,"t":"(Not failing,) of the church","ru":"(Неиссякающий) — Церковь","r":["ISA 58:11"]},{"l":2,"t":"(Always flowing,) of unceasing wickedness of the Jews","ru":"(Непрестанно текущий) — непрестанное нечестие иудеев","r":["JER 6:7"]},{"l":2,"t":"(Corrupt,) of the natural heart","ru":"(Испорченный) — природное сердце человека","r":["JAS 3:11","MAT 15:18","MAT 15:19"]},{"l":2,"t":"(Troubled,) of saints led astray","ru":"(Возмущённый) — святые, совращённые с пути","r":["PRO 25:26"]}]}
