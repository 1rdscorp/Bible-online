{"id":"bow","en":"Bow","ru":"Лук","lines":[{"l":1,"t":"An instrument of war","r":["GEN 48:22","ISA 7:24"]},{"l":1,"t":"Sometimes used in hunting","r":["GEN 27:3"]},{"l":1,"t":"For shooting arrows","r":["1CH 12:2"]},{"l":1,"t":"Called the battle bow","r":["ZEC 9:10","ZEC 10:4"]},{"l":1,"t":"Those who used, called","r":[]},{"l":2,"t":"Bowmen","r":["JER 4:29"]},{"l":2,"t":"Archers","r":["1SA 31:3","JER 51:3"]},{"l":1,"t":"Usually of steel","r":["2SA 22:35","JOB 20:24"]},{"l":1,"t":"Held in the left hand","r":["EZK 39:3"]},{"l":1,"t":"Drawn with full force","r":["2KI 9:24"]},{"l":1,"t":"The Jews taught to use","r":["2SA 1:18"]},{"l":1,"t":"Used expertly by","r":[]},{"l":2,"t":"Lydians","r":["JER 46:9"]},{"l":2,"t":"Elamites","r":["JER 49:35"]},{"l":2,"t":"Philistines","r":["1SA 31:2","1SA 31:3"]},{"l":2,"t":"Sons of Reuben, Gad, and Manasseh","r":["1CH 5:18"]},{"l":2,"t":"Benjamites","r":["1CH 12:2","2CH 14:8"]},{"l":1,"t":"Given as a token of friendship","r":["1SA 18:4"]},{"l":1,"t":"Often furnished by the state","r":["2CH 26:14"]},{"l":1,"t":"Of the vanquished, broken and burned","r":["PSA 37:15","EZK 39:9"]},{"l":1,"t":"Illustrative","r":[]},{"l":2,"t":"Of strength and power","r":["JOB 29:20"]},{"l":2,"t":"Of the tongue of the wicked","r":["PSA 11:2","JER 9:3"]},{"l":2,"t":"(When deceitful,) of the hypocrite","r":["PSA 78:57","HOS 7:16"]},{"l":2,"t":"(When broken,) of the overthrow of power","r":["1SA 2:4","JER 49:35","HOS 1:5","HOS 2:18"]}]}
