{"id":"bow","en":"Bow","ru":"Лук","lines":[{"l":1,"t":"An instrument of war","ru":"Военное оружие","r":["GEN 48:22","ISA 7:24"]},{"l":1,"t":"Sometimes used in hunting","ru":"Иногда использовался на охоте","r":["GEN 27:3"]},{"l":1,"t":"For shooting arrows","ru":"Для пускания стрел","r":["1CH 12:2"]},{"l":1,"t":"Called the battle bow","ru":"Называется бранным луком","r":["ZEC 9:10","ZEC 10:4"]},{"l":1,"t":"Those who used, called","ru":"Пользовавшиеся им назывались:","r":[]},{"l":2,"t":"Bowmen","ru":"Стреляющие из лука","r":["JER 4:29"]},{"l":2,"t":"Archers","ru":"Стрелки","r":["1SA 31:3","JER 51:3"]},{"l":1,"t":"Usually of steel","ru":"Обычно медный","r":["2SA 22:35","JOB 20:24"]},{"l":1,"t":"Held in the left hand","ru":"Держался в левой руке","r":["EZK 39:3"]},{"l":1,"t":"Drawn with full force","ru":"Натягивался с полной силой","r":["2KI 9:24"]},{"l":1,"t":"The Jews taught to use","ru":"Иудеев учили владеть им","r":["2SA 1:18"]},{"l":1,"t":"Used expertly by","ru":"Искусно владели им:","r":[]},{"l":2,"t":"Lydians","ru":"Лидяне","r":["JER 46:9"]},{"l":2,"t":"Elamites","ru":"Еламитяне","r":["JER 49:35"]},{"l":2,"t":"Philistines","ru":"Филистимляне","r":["1SA 31:2","1SA 31:3"]},{"l":2,"t":"Sons of Reuben, Gad, and Manasseh","ru":"Сыны Рувима, Гада и Манассии","r":["1CH 5:18"]},{"l":2,"t":"Benjamites","ru":"Вениамитяне","r":["1CH 12:2","2CH 14:8"]},{"l":1,"t":"Given as a token of friendship","ru":"Давался в знак дружбы","r":["1SA 18:4"]},{"l":1,"t":"Often furnished by the state","ru":"Часто выдавался от государства","r":["2CH 26:14"]},{"l":1,"t":"Of the vanquished, broken and burned","ru":"Луки побеждённых ломали и сжигали","r":["PSA 37:15","EZK 39:9"]},{"l":1,"t":"Illustrative","ru":"Образ:","r":[]},{"l":2,"t":"Of strength and power","ru":"Крепости и силы","r":["JOB 29:20"]},{"l":2,"t":"Of the tongue of the wicked","ru":"Языка нечестивых","r":["PSA 11:2","JER 9:3"]},{"l":2,"t":"(When deceitful,) of the hypocrite","ru":"(Неверный лук) — лицемера","r":["PSA 78:57","HOS 7:16"]},{"l":2,"t":"(When broken,) of the overthrow of power","ru":"(Сломанный) — низвержения силы","r":["1SA 2:4","JER 49:35","HOS 1:5","HOS 2:18"]}]}
