{"id":"conscience","en":"Conscience","ru":"Совесть","lines":[{"l":1,"t":"Witnesses in man","ru":"Свидетельствует в человеке","r":["PRO 20:27","ROM 2:15"]},{"l":1,"t":"Accuses of sin","ru":"Обличает в грехе","r":["GEN 42:21","2SA 24:10","MAT 27:3","ACT 2:37"]},{"l":1,"t":"We should have the approval of","ru":"Мы должны иметь её одобрение","r":["JOB 27:6","ACT 24:16","ROM 9:1","ROM 14:22"]},{"l":1,"t":"The blood of Christ alone can purify","ru":"Только Кровь Христова может очистить её","r":["HEB 9:14","HEB 10:2-10","HEB 10:22"]},{"l":1,"t":"Keep the faith in purity of","ru":"Хранить веру в чистой совести","r":["1TI 1:19","1TI 3:9"]},{"l":1,"t":"Of saints, pure and good","ru":"Совесть святых чиста и добра","r":["HEB 13:18","1PE 3:16","1PE 3:21"]},{"l":1,"t":"Submit to authority for","ru":"Повиноваться властям по совести","r":["ROM 13:5"]},{"l":1,"t":"Suffer patiently for","ru":"Терпеливо страдать ради совести","r":["1PE 2:19"]},{"l":1,"t":"Testimony of, a source of joy","ru":"Её свидетельство — источник радости","r":["2CO 1:12","1JN 3:21"]},{"l":1,"t":"Of others, not to be offended","ru":"Не соблазнять совести других","r":["ROM 14:21","1CO 10:28-32"]},{"l":1,"t":"Ministers should commend themselves to that of their people","ru":"Служители должны представлять себя совести своих слушателей","r":["2CO 4:2","2CO 5:11"]},{"l":1,"t":"Of the wicked, seared","ru":"Совесть нечестивых сожжена","r":["1TI 4:2"]},{"l":1,"t":"Of the wicked, defiled","ru":"Совесть нечестивых осквернена","r":["TIT 1:15"]},{"l":1,"t":"Without spiritual illumination, a false guide","ru":"Без духовного просвещения — ложный руководитель","r":["ACT 23:1","ACT 26:9"]}]}
