{"id":"calf-of-gold","en":"Calf of Gold","ru":"Золотой телец","lines":[{"l":1,"t":"Made on account of the delay of Moses in the mount","r":["EXO 32:1"]},{"l":1,"t":"Was made","r":[]},{"l":2,"t":"Of the ornaments of the women, &c","r":["EXO 32:2","EXO 32:3"]},{"l":2,"t":"To represent God","r":["EXO 32:4","EXO 32:5","PSA 106:20"]},{"l":2,"t":"After an Egyptian model","r":["ACT 7:39","ACT 7:41"]},{"l":1,"t":"To go before the congregation","r":["EXO 32:1"]},{"l":1,"t":"Molten in the fire","r":["EXO 32:4","PSA 106:19"]},{"l":1,"t":"Fashioned with a graven tool","r":["EXO 32:4"]},{"l":1,"t":"An altar built before","r":["EXO 32:5"]},{"l":1,"t":"Sacrifices offered to","r":["EXO 32:6","ACT 7:41"]},{"l":1,"t":"Worshipped with profane revelry","r":["EXO 32:6","EXO 32:18","EXO 32:19","EXO 32:25","1CO 10:7"]},{"l":1,"t":"Making of","r":[]},{"l":2,"t":"A very great sin","r":["EXO 32:21","EXO 32:30","EXO 32:31"]},{"l":2,"t":"A forgetting of God","r":["PSA 106:21"]},{"l":2,"t":"A turning aside from the divine command","r":["EXO 32:8","DEU 9:12","DEU 9:16"]},{"l":2,"t":"Excited wrath against Aaron","r":["DEU 9:20"]},{"l":2,"t":"Excited wrath against Israel","r":["EXO 32:10","DEU 9:14","DEU 9:19"]},{"l":2,"t":"Caused Moses to break the tables of the testimony","r":["EXO 32:19","DEU 9:17"]},{"l":2,"t":"Israel punished for","r":["EXO 32:26-29","EXO 32:35"]},{"l":1,"t":"Moses interceded for those who worshipped","r":["EXO 32:11-14","EXO 32:30-34","DEU 9:18-20"]},{"l":1,"t":"Destroyed by Moses","r":["EXO 32:20","DEU 9:21"]},{"l":1,"t":"Punishment of those who worshipped a warning to others","r":["1CO 10:5-7"]}]}
