{"id":"calf-of-gold","en":"Calf of Gold","ru":"Золотой телец","lines":[{"l":1,"t":"Made on account of the delay of Moses in the mount","ru":"Сделан из-за того, что Моисей долго не сходил с горы","r":["EXO 32:1"]},{"l":1,"t":"Was made","ru":"Был сделан:","r":[]},{"l":2,"t":"Of the ornaments of the women, &c","ru":"Из украшений женщин и т. д.","r":["EXO 32:2","EXO 32:3"]},{"l":2,"t":"To represent God","ru":"Чтобы изображать Бога","r":["EXO 32:4","EXO 32:5","PSA 106:20"]},{"l":2,"t":"After an Egyptian model","ru":"По египетскому образцу","r":["ACT 7:39","ACT 7:41"]},{"l":1,"t":"To go before the congregation","ru":"Чтобы идти перед обществом","r":["EXO 32:1"]},{"l":1,"t":"Molten in the fire","ru":"Вылит в огне","r":["EXO 32:4","PSA 106:19"]},{"l":1,"t":"Fashioned with a graven tool","ru":"Обработан резцом","r":["EXO 32:4"]},{"l":1,"t":"An altar built before","ru":"Перед ним построен жертвенник","r":["EXO 32:5"]},{"l":1,"t":"Sacrifices offered to","ru":"Ему приносились жертвы","r":["EXO 32:6","ACT 7:41"]},{"l":1,"t":"Worshipped with profane revelry","ru":"Почитался с нечестивым разгулом","r":["EXO 32:6","EXO 32:18","EXO 32:19","EXO 32:25","1CO 10:7"]},{"l":1,"t":"Making of","ru":"Изготовление его:","r":[]},{"l":2,"t":"A very great sin","ru":"Великий грех","r":["EXO 32:21","EXO 32:30","EXO 32:31"]},{"l":2,"t":"A forgetting of God","ru":"Забвение Бога","r":["PSA 106:21"]},{"l":2,"t":"A turning aside from the divine command","ru":"Уклонение от Божией заповеди","r":["EXO 32:8","DEU 9:12","DEU 9:16"]},{"l":2,"t":"Excited wrath against Aaron","ru":"Навлекло гнев на Аарона","r":["DEU 9:20"]},{"l":2,"t":"Excited wrath against Israel","ru":"Навлекло гнев на Израиль","r":["EXO 32:10","DEU 9:14","DEU 9:19"]},{"l":2,"t":"Caused Moses to break the tables of the testimony","ru":"Побудило Моисея разбить скрижали откровения","r":["EXO 32:19","DEU 9:17"]},{"l":2,"t":"Israel punished for","ru":"Израиль наказан за него","r":["EXO 32:26-29","EXO 32:35"]},{"l":1,"t":"Moses interceded for those who worshipped","ru":"Моисей ходатайствовал за поклонявшихся ему","r":["EXO 32:11-14","EXO 32:30-34","DEU 9:18-20"]},{"l":1,"t":"Destroyed by Moses","ru":"Уничтожен Моисеем","r":["EXO 32:20","DEU 9:21"]},{"l":1,"t":"Punishment of those who worshipped a warning to others","ru":"Наказание поклонявшихся ему — предостережение другим","r":["1CO 10:5-7"]}]}
