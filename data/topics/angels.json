{"id":"angels","en":"Angels","ru":"Ангелы","lines":[{"l":1,"t":"Created by God and Christ","ru":"Сотворены Богом и Христом","r":["NEH 9:6","COL 1:16"]},{"l":1,"t":"Worship God and Christ","ru":"Поклоняются Богу и Христу","r":["NEH 9:6","PHP 2:9-11","HEB 1:6"]},{"l":1,"t":"Are ministering Spirits","ru":"Служебные духи","r":["1KI 19:5","PSA 68:17","PSA 104:4","LUK 16:22","ACT 12:7-11","ACT 27:23","HEB 1:7","HEB 1:14"]},{"l":1,"t":"Communicate the will of God and Christ","ru":"Возвещают волю Бога и Христа","r":["DAN 8:16","DAN 8:17","DAN 9:21-23","DAN 10:11","DAN 12:6","DAN 12:7","MAT 2:13","MAT 2:20","LUK 1:19","LUK 1:28","ACT 5:20","ACT 8:26","ACT 10:5","ACT 27:23","REV 1:1"]},{"l":1,"t":"Obey the will of God","ru":"Исполняют волю Божию","r":["PSA 103:20","MAT 6:10"]},{"l":1,"t":"Execute the purposes of God","ru":"Исполняют намерения Божии","r":["NUM 22:22","PSA 103:21","MAT 13:39-42","MAT 28:2","JHN 5:4","REV 5:2"]},{"l":1,"t":"Execute the judgments of God","ru":"Исполняют суды Божии","r":["2SA 24:16","2KI 19:35","PSA 35:5","PSA 35:6","ACT 12:23","REV 16:1"]},{"l":1,"t":"Celebrate the praises of God","ru":"Воспевают хвалу Богу","r":["JOB 38:7","PSA 148:2","ISA 6:3","LUK 2:13","LUK 2:14","REV 5:11","REV 5:12","REV 7:11","REV 7:12"]},{"l":1,"t":"The law given by the ministration of","ru":"Закон преподан через них","r":["PSA 68:17","ACT 7:53","HEB 2:2"]},{"l":1,"t":"Announced","ru":"Возвестили:","r":[]},{"l":2,"t":"The conception of Christ","ru":"Зачатие Христа","r":["MAT 1:20","MAT 1:21","LUK 1:31"]},{"l":2,"t":"The birth of Christ","ru":"Рождение Христа","r":["LUK 2:10-12"]},{"l":2,"t":"The resurrection of Christ","ru":"Воскресение Христа","r":["MAT 28:5-7","LUK 24:23"]},{"l":2,"t":"The ascension and second coming of Christ","ru":"Вознесение и второе пришествие Христа","r":["ACT 1:11"]},{"l":2,"t":"The conception of John the Baptist","ru":"Зачатие Иоанна Крестителя","r":["LUK 1:13","LUK 1:36"]},{"l":1,"t":"Minister to Christ","ru":"Служат Христу","r":["MAT 4:11","LUK