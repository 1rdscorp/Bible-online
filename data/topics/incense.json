{"id":"incense","en":"Incense","ru":"Курение (фимиам)","lines":[{"l":1,"t":"Brought from Sheba","ru":"Привозилось из Савы","r":["JER 6:20"]},{"l":1,"t":"Called frankincense","ru":"Называется ливаном","r":["SNG 4:6","SNG 4:14"]},{"l":1,"t":"An article of extensive commerce","ru":"Предмет обширной торговли","r":["REV 18:13"]},{"l":1,"t":"Common, not to be offered to God","ru":"Чуждое курение не приносилось Богу","r":["EXO 30:9"]},{"l":1,"t":"For God’s service mixed with sweet spices","ru":"Для служения Богу смешивалось с благовониями","r":["EXO 25:6","EXO 37:29"]},{"l":1,"t":"Receipt for mixing","ru":"Способ приготовления","r":["EXO 30:34-36"]},{"l":1,"t":"None but priest to offer","ru":"Приносить его мог лишь священник","r":["NUM 16:40","DEU 33:10"]},{"l":1,"t":"Offered","ru":"Приносилось:","r":[]},{"l":2,"t":"In censers","ru":"В кадильницах","r":["LEV 10:1","NUM 16:17","NUM 16:46"]},{"l":2,"t":"On the altar of gold","ru":"На золотом жертвеннике","r":["EXO 30:1","EXO 30:6","EXO 40:5"]},{"l":2,"t":"Morning and evening","ru":"Утром и вечером","r":["EXO 30:7","EXO 30:8"]},{"l":2,"t":"Perpetually","ru":"Постоянно","r":["EXO 30:8"]},{"l":2,"t":"By the high priest in the most holy place on the day of atonement","ru":"Первосвященником во Святом Святых в день очищения","r":["LEV 16:12","LEV 16:13"]},{"l":2,"t":"With fire from off the altar of burnt offering","ru":"С огнём с жертвенника всесожжения","r":["LEV 16:12","NUM 16:46"]},{"l":1,"t":"Offering of, allotted to the priests","ru":"Приношение его поручено священникам","r":["LUK 1:9"]},{"l":1,"t":"The Jews prayed at time of offering","ru":"Во время курения иудеи молились","r":["LUK 1:10"]},{"l":1,"t":"Designed for atonement","ru":"Служило для очищения","r":["NUM 16:46","NUM 16:47"]},{"l":1,"t":"Put on meat offerings","ru":"Возлагалось на хлебные приношения","r":["LEV 2:1","LEV 2:2","LEV 2:15","LEV 2:16","LEV 6:15"]},{"l":1,"t":"Levites had charge of","ru":"Было поручено левитам","r":["1CH 9:29"]},{"l":1,"t":"Used in idolatrous worship","ru":"Использовалось в идолослужении","r":["JER 48:35"]},{"l":1,"t":"The Jews","ru":"Иудеи:","r":[]},{"l":2,"t":"Not accepted in offering, on account of sin","ru":"Их курение не принималось из-за греха","r":["ISA 1:13","ISA 66:3"]},{"l":2,"t":"Offered, to idols on altars of brick","ru":"Кадили идолам на кирпичных жертвенниках","r":["ISA 65:3"]},{"l":2,"t":"Punished for offering, to idols","ru":"Наказаны за курение идолам","r":["2CH 34:25"]},{"l":1,"t":"Nadab and Abihu destroyed for offering, with strange fire","ru":"Надав и Авиуд погибли за курение с чуждым огнём","r":["LEV 10:1","LEV 10:2"]},{"l":1,"t":"Korah and his company punished for offering","ru":"Корей и его сообщники наказаны за курение","r":["NUM 16:16-35"]},{"l":1,"t":"Uzziah punished for offering","ru":"Озия наказан за курение","r":["2CH 26:16-21"]},{"l":1,"t":"Presented to Christ by the wise men","ru":"Принесено Христу волхвами","r":["MAT 2:11"]},{"l":1,"t":"Illustrative of","ru":"Образ:","r":[]},{"l":2,"t":"The merits of Christ","ru":"Заслуг Христа","r":["REV 8:3","REV 8:4"]},{"l":2,"t":"Prayer","ru":"Молитвы","r":["PSA 141:2","MAL 1:11","REV 5:8"]}]}
