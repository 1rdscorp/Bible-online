{"id":"lion","en":"Lion","ru":"Лев","lines":[{"l":1,"t":"Canaan infested by","ru":"Водился в Ханаане во множестве","r":["2KI 17:25","2KI 17:26"]},{"l":1,"t":"Described as","ru":"Описывается как:","r":[]},{"l":2,"t":"Superior in strength","ru":"Сильнейший из зверей","r":["JDG 14:18","PRO 30:30"]},{"l":2,"t":"Active","ru":"Подвижный","r":["DEU 33:22"]},{"l":2,"t":"Courageous","ru":"Отважный","r":["2SA 17:10"]},{"l":2,"t":"Fearless even of man","ru":"Не боящийся даже человека","r":["ISA 31:4","NAM 2:11"]},{"l":2,"t":"Fierce","ru":"Свирепый","r":["JOB 10:16","JOB 28:8"]},{"l":2,"t":"Voracious","ru":"Прожорливый","r":["PSA 17:12"]},{"l":2,"t":"Majestic in movement","ru":"Величественный в поступи","r":["PRO 30:29","PRO 30:30"]},{"l":1,"t":"Greatness of its teeth alluded to","ru":"Его огромные зубы упоминаются","r":["PSA 58:6","JOL 1:6"]},{"l":1,"t":"God’s power exhibited in restraining","ru":"Сила Божия являет себя в обуздании львов","r":["1KI 13:28","DAN 6:22","DAN 6:27"]},{"l":1,"t":"God provides for","ru":"Бог даёт ему пищу","r":["JOB 38:39","PSA 104:21","PSA 104:28"]},{"l":1,"t":"Lurks for its prey","ru":"Подстерегает добычу","r":["PSA 10:9"]},{"l":1,"t":"Roars when seeking prey","ru":"Рыкает, ища добычи","r":["PSA 104:21","ISA 31:4"]},{"l":1,"t":"Rends its prey","ru":"Терзает добычу","r":["DEU 33:20","PSA 7:2"]},{"l":1,"t":"Often carries its prey to its den","ru":"Часто уносит добычу в логово","r":["NAM 2:12"]},{"l":1,"t":"Conceals itself by day","ru":"Днём скрывается","r":["PSA 104:22"]},{"l":1,"t":"Often perishes for lack of food","ru":"Часто погибает от недостатка пищи","r":["JOB 4:11"]},{"l":1,"t":"Inhabits","ru":"Обитает:","r":[]},{"l":2,"t":"Forests","ru":"В лесах","r":["JER 5:6"]},{"l":2,"t":"Thickets","ru":"В чащах","r":["JER 4:7"]},{"l":2,"t":"Mountains","ru":"В горах","r":["SNG 4:8"]},{"l":2,"t":"Deserts","ru":"В пустынях","r":["ISA 30:6"]},{"l":1,"t":"Attacks the sheepfolds","ru":"Нападает на овчарни","r":["1SA 17:34","AMO 3:12","MIC 5:8"]},{"l":1,"t":"Attacks and destroys men","ru":"Нападает на людей и губит их","r":["1KI 13:24","1KI 20:36"]},{"l":1,"t":"Universal terror caused by roaring of","ru":"Рыкание его наводит всеобщий ужас","r":["JER 2:15","AMO 3:8"]},{"l":1,"t":"Criminals often thrown to","ru":"Преступников часто бросали львам","r":["DAN 6:7","DAN 6:16","DAN 6:24"]},{"l":1,"t":"Hunting of, alluded to","ru":"Охота на львов упоминается","r":["JOB 10:16"]},{"l":1,"t":"Slain by","ru":"Убит:","r":[]},{"l":2,"t":"Samson","ru":"Самсоном","r":["JDG 14:5","JDG 14:6"]},{"l":2,"t":"David","ru":"Давидом","r":["1SA 17:35","1SA 17:36"]},{"l":2,"t":"Benaiah","ru":"Ванеей","r":["2SA 23:20"]},{"l":1,"t":"A swarm of bees found in the carcass of, by Samson","ru":"Самсон нашёл рой пчёл в трупе льва","r":["JDG 14:8"]},{"l":1,"t":"Disobedient prophet slain by","ru":"Непослушный пророк убит львом","r":["1KI 13:24","1KI 13:26"]},{"l":1,"t":"Illustrative","ru":"Образ:","r":[]},{"l":2,"t":"Of Israel","ru":"Израиля","r":["NUM 24:9"]},{"l":2,"t":"Of the tribe of Judah","ru":"Колена Иудина","r":["GEN 49:9"]},{"l":2,"t":"Of the tribe of Gad","ru":"Колена Гадова","r":["DEU 33:20"]},{"l":2,"t":"Of Christ","ru":"Христа","r":["REV 5:5"]},{"l":2,"t":"Of God in protecting his church","ru":"Бога, защищающего Свою Церковь","r":["ISA 31:4"]},{"l":2,"t":"Of God in executing judgments","ru":"Бога, совершающего суды","r":["ISA 38:13","LAM 3:10","HOS 5:14","HOS 13:8"]},{"l":2,"t":"Of boldness of saints","ru":"Дерзновения святых","r":["PRO 28:1"]},{"l":2,"t":"Of brave men","ru":"Храбрых мужей","r":["2SA 1:23","2SA 23:20"]},{"l":2,"t":"Of cruel and powerful enemies","ru":"Жестоких и сильных врагов","r":["ISA 5:29","JER 49:19","JER 51:38"]},{"l":2,"t":"Of persecutors","ru":"Гонителей","r":["PSA 22:13","2TI 4:17"]},{"l":2,"t":"Of the devil","ru":"Диавола","r":["1PE 5:8"]},{"l":2,"t":"Of imaginary fears of the slothful","ru":"Мнимых страхов ленивых","r":["PRO 22:13","PRO 26:13"]},{"l":2,"t":"(Tamed,) of the natural man subdued by grace","ru":"(Укрощённый) — природного человека, покорённого благодатью","r":["ISA 11:7","ISA 65:25"]},{"l":2,"t":"(Roaring of,) of a king’s wrath","ru":"(Рыкание льва) — гнева царя","r":["PRO 19:12","PRO 20:2"]}]}
