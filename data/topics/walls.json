{"id":"walls","en":"Walls","ru":"Стены","lines":[{"l":1,"t":"Designed for separation","r":["EZK 43:8","EPH 2:14"]},{"l":1,"t":"Designed for defence","r":["1SA 25:16"]},{"l":1,"t":"Mentioned in scripture","r":[]},{"l":2,"t":"Of cities","r":["NUM 13:28"]},{"l":2,"t":"Of temples","r":["1CH 29:4","ISA 56:5"]},{"l":2,"t":"Of houses","r":["1SA 18:11"]},{"l":2,"t":"Of vineyards","r":["NUM 22:24","PRO 24:31"]},{"l":1,"t":"Frequently made of stone and wood together","r":["EZR 5:8","HAB 2:11"]},{"l":1,"t":"Were probably often strengthened with plates of iron or brass","r":["JER 15:20","EZK 4:3"]},{"l":1,"t":"Of cities","r":[]},{"l":2,"t":"Often very high","r":["DEU 1:28","DEU 3:5"]},{"l":2,"t":"Strongly fortified","r":["ISA 2:15","ISA 25:12"]},{"l":2,"t":"Had towers built on them","r":["2CH 26:9","2CH 32:5","PSA 48:12","SNG 8:10"]},{"l":2,"t":"Houses often built on","r":["JOS 2:15"]},{"l":2,"t":"Were broad and places of public resort","r":["2KI 6:26","2KI 6:30","PSA 55:10"]},{"l":2,"t":"Were strongly manned in war","r":["2KI 18:26"]},{"l":2,"t":"Kept by watchmen night and day","r":["SNG 5:7","ISA 62:6"]},{"l":2,"t":"Houses sometimes broken down to repair, and fortify","r":["ISA 22:10"]},{"l":2,"t":"Danger of approaching too near to, in time of war","r":["2SA 11:20","2SA 11:21"]},{"l":2,"t":"Were battered by besieging armies","r":["2SA 20:15","EZK 4:2","EZK 4:3"]},{"l":2,"t":"Adroitness of soldiers in scaling alluded to","r":["JOL 2:7-9"]},{"l":2,"t":"Sometimes burned","r":["JER 49:27","AMO 1:7"]},{"l":2,"t":"Frequently laid in ruins","r":["2CH 25:23","2CH 36:19","JER 50:15"]},{"l":2,"t":"Destruction of, a punishment and cause of grief","r":["DEU 28:52","NEH 1:3","NEH 2:12-17"]},{"l":2,"t":"The falling of, sometimes occasioned great destruction","r":["1KI 20:30"]},{"l":2,"t":"The bodies of enemies sometimes fastened on, as a disgrace","r":["1SA 31:10"]},{"l":2,"t":"Custom of dedicating","r":["NEH 12:27"]},{"l":2,"t":"idolatrous rites performed on","r":["2KI 3:27"]},{"l":2,"t":"Instances of persons let down from","r":["JOS 2:15","ACT 9:24","ACT 9:25","2CO 11:33"]},{"l":1,"t":"Small towns and villages were not surrounded by","r":["LEV 25:31","DEU 3:5"]},{"l":1,"t":"Of houses","r":[]},{"l":2,"t":"Usually plastered","r":["EZK 13:10","DAN 5:5"]},{"l":2,"t":"Had nails or pegs fastened into them when built","r":["ECC 12:11","ISA 22:23"]},{"l":2,"t":"Liable to leprosy","r":["LEV 14:37"]},{"l":2,"t":"Often infested with serpents","r":["AMO 5:19"]},{"l":2,"t":"Could be easily dug through","r":["GEN 49:6","EZK 8:7","EZK 8:8","EZK 12:5"]},{"l":2,"t":"The seat next, was the place of distinction","r":["1SA 20:25"]},{"l":1,"t":"Hyssop frequently grew on","r":["1KI 4:33"]},{"l":1,"t":"Miracles connected with","r":[]},{"l":2,"t":"Falling of the walls of Jericho","r":["JOS 6:20"]},{"l":2,"t":"Handwriting on the wall of Belshazzar’s palace","r":["DAN 5:5","DAN 5:25-28"]},{"l":1,"t":"Illustrative","r":[]},{"l":2,"t":"Of salvation","r":["ISA 26:1","ISA 60:18"]},{"l":2,"t":"Of the protection of God","r":["ZEC 2:5"]},{"l":2,"t":"Of those who afford protection","r":["1SA 25:16","ISA 2:15"]},{"l":2,"t":"Of the Church as a protection to the nation","r":["SNG 8:9","SNG 8:10"]},{"l":2,"t":"Of ordinances as a protection to the Church","r":["SNG 2:9","ISA 5:5"]},{"l":2,"t":"Of the wealth of the rich in his own conceit","r":["PRO 18:11"]},{"l":2,"t":"(Brazen,) of prophets in their testimony against the wicked","r":["JER 22:20"]},{"l":2,"t":"(Bowing or tottering,) of the wicked under judgments","r":["PSA 62:3","ISA 30:13"]},{"l":2,"t":"(Of partition,) of separation of Jews and Gentiles","r":["EPH 2:14"]},{"l":2,"t":"(Daubed with untempered mortar,) of the teaching of false prophets","r":["EZK 13:10-15"]},{"l":2,"t":"(Whited,) of hypocrites","r":["ACT 23:3"]}]}
